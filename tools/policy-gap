#!/usr/bin/env python3
import datetime
import gzip
import pathlib
import subprocess

root = pathlib.Path(__file__).resolve().parents[1]
scratch = root / "tmp/policy-gap-v1"
scratch.mkdir(parents=True, exist_ok=True)
(scratch / "corpus.jsonl").write_bytes(gzip.decompress((root / "findings/policy-gap-v1/corpus.jsonl.gz").read_bytes()))
subprocess.run(["cargo", "build", "--release", "-p", "nc2000-bot", "--example", "endgame_policy_audit"], cwd=root, check=True)
destination = scratch / datetime.datetime.now().strftime("run-%Y%m%d-%H%M%S")
subprocess.run(["target/release/examples/endgame_policy_audit", "findings/policy-gap-v1/protocol.json", str(destination)], cwd=root, check=True)
subprocess.run(["python3", "tools/policy-gap-report.py", str(destination), str(destination / "report")], cwd=root, check=True)
print(f"Report: {destination / 'report'}")
