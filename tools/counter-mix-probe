#!/usr/bin/env python3
import argparse
import collections
import gzip
import hashlib
import json
import os
import pathlib
import subprocess
import tempfile

root = pathlib.Path(__file__).resolve().parents[1]
archive = root / 'findings/counter-mix-v1'
stages = {'screen': (64, 27000, 2026110101), 'confirmation': (64, 108000, 2026110201)}


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def loss(record, side, policy):
    assert abs(sum(policy)-1) < 1e-10 and min(policy) >= 0
    n0, n1 = map(len, record['actions'])
    cells = record['proof']['cells']
    lower, upper = [], []
    for reply in range([n1, n0][side]):
        lo = hi = 0
        for i, mass in enumerate(policy):
            a, b = (i, reply) if side == 0 else (reply, i)
            cl, ch = cells[a*n1+b]
            if side == 1:
                cl, ch = 1-ch, 1-cl
            lo += mass*cl
            hi += mass*ch
        lower.append(lo)
        upper.append(hi)
    vl, vh = record['proof']['value']
    if side == 1:
        vl, vh = 1-vh, 1-vl
    return [max(0, vl-min(upper)-1e-10), max(0, vh-min(lower)+1e-10)]


def summarize(records, corpora, manifest):
    result = {}
    seen = {}
    for stage, (count, iterations, seed_base) in stages.items():
        r = records[stage]
        corpus = corpora[stage]
        assert sha(corpus.encode()) == manifest['corpus_sha256'][stage]
        c = json.loads(corpus)
        assert c['prefix_only'] and c['outcome'] is None and c['samples'] == [8]
        assert len(c['decisions']) == 9 and c['decisions'][-1]['key'] == r['state_key']
        assert all(v['ok'] for v in r['validations'])
        assert all(len(team) == 6 for team in c['teams'])
        assert (r['search_seeds'], r['iterations'], r['search_seed_base']) == (count, iterations, seed_base)
        assert r['proof']['value'][1]-r['proof']['value'][0] < 1e-8
        assert len(r['proof']['cells']) == len(r['actions'][0])*len(r['actions'][1])
        assert all(-1e-10 <= lo <= hi+1e-10 <= 1+1e-10 for lo, hi in r['proof']['cells'])
        assert [(row['seed_index'], row['side'], row['mode']) for row in r['rows']] == [
            (i, side, mode) for i in range(count) for side in range(2) for mode in ['full', 'pinned']]
        for row in r['rows']:
            assert row['seed'] == seed_base ^ ((row['seed_index']*0x94d049bb133111eb) % (1 << 64))
            assert row['choice'] in r['actions'][row['side']]
            assert row['iterations'] == sum(row['visits']) == iterations
            assert len(row['visits']) == len(r['actions'][row['side']])
        seen[stage] = {row['seed'] for row in r['rows']}
        groups = []
        for mode in ['full', 'pinned']:
            for side in range(2):
                rows = [row for row in r['rows'] if row['mode'] == mode and row['side'] == side]
                actions = r['actions'][side]
                counts = collections.Counter(row['choice'] for row in rows)
                actual = [counts[a]/count for a in actions]
                visit_mix = [sum(row['visits'][i]/iterations for row in rows)/count for i in range(len(actions))]
                measured_loss = loss(r, side, actual)
                groups.append(dict(mode=mode, side=side, counts=dict(counts),
                                   empirical_choice_policy=actual, empirical_choice_loss=measured_loss,
                                   average_visit_policy=visit_mix, average_visit_loss=loss(r, side, visit_mix)))
        controls = []
        for side in range(2):
            n = len(r['actions'][side])
            eq = r['proof']['lower_mix'][side] if side == 0 else r['proof']['upper_mix'][side]
            eq_loss = loss(r, side, eq)
            assert eq_loss[1] < 1e-8
            assert max(loss(r, side, [float(i == j) for i in range(n)])[0] for j in range(n)) > .45
            controls.append(dict(side=side, equilibrium=eq, equilibrium_loss=eq_loss,
                                 uniform_loss=loss(r, side, [1/n]*n),
                                 pure_losses=[loss(r, side, [float(i == j) for i in range(n)]) for j in range(n)]))
        result[stage] = dict(value=r['proof']['value'], actions=r['actions'], matrix=r['proof']['cells'],
                             controls=controls, groups=groups)
    assert seen['screen'].isdisjoint(seen['confirmation'])
    assert records['screen']['state_key'] == records['confirmation']['state_key']
    result['scope'] = ('One legally reached fixed-loadout endgame. Loss compares the empirical first-action distribution '
                       'with the actual full-state minimax value, granting optimal continuation. Pinned search uses public '
                       'history and a known team; this is not a shipped-pool or whole-policy exploitability certificate. '
                       'Visit mixtures are a diagnostic selection-rule ablation, not a production change. '
                       'Finite empirical losses do not establish a population error rate over all search seeds.')
    return result


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--verify-only', action='store_true')
    parser.add_argument('--import-directory', type=pathlib.Path)
    args = parser.parse_args()
    if args.verify_only:
        records = json.loads(gzip.decompress((archive/'records.json.gz').read_bytes()))
        corpora = json.loads(gzip.decompress((archive/'corpora.json.gz').read_bytes()))
        manifest = json.loads((archive/'manifest.json').read_bytes())
        summary = summarize(records, corpora, manifest)
        assert summary == json.loads((archive/'summary.json').read_bytes())
        print('counter-mix: verified legal-prefix metadata, payoff controls, disjoint seeds and policy losses')
        return
    env = {**os.environ, 'NC2000_REPO_ROOT': str(root)}
    if args.import_directory:
        directory = args.import_directory
    else:
        subprocess.run(['cargo', 'build', '--release', '-p', 'nc2000-bot', '--example', 'counter_mix_probe'], cwd=root, env=env, check=True)
        directory = pathlib.Path(tempfile.mkdtemp(prefix='nc-counter-mix-'))
        for name, (count, iterations, seed) in stages.items():
            subprocess.run([str(root/'target/release/examples/counter_mix_probe'), str(directory/name),
                            '1,2,3,4', str(count), str(iterations), str(seed)], cwd=root, env=env, check=True)
    records = {name: json.loads((directory/name/'records.json').read_bytes()) for name in stages}
    corpora = {name: (directory/name/'corpus.jsonl').read_text() for name in stages}
    for r in records.values():
        assert all(sha((root/path).read_bytes()) == expected for path, expected in r['source_hashes'])
        assert sha((root/'target/release/examples/counter_mix_probe').read_bytes()) == r['binary_sha256']
    sources = sorted((root/'crates/engine/src').rglob('*.rs')) + sorted((root/'crates/bot/src').rglob('*.rs'))
    manifest = dict(revision=subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=root, text=True).strip(),
                    source_sha256={str(path.relative_to(root)): sha(path.read_bytes()) for path in sources},
                    corpus_sha256={name: sha(corpus.encode()) for name, corpus in corpora.items()})
    summary = summarize(records, corpora, manifest)
    archive.mkdir(exist_ok=False)
    for name, content in [('records', records), ('corpora', corpora)]:
        (archive/(name+'.json.gz')).write_bytes(gzip.compress(json.dumps(content, separators=(',', ':')).encode(), mtime=0))
    for name, content in [('manifest', manifest), ('summary', summary)]:
        (archive/(name+'.json')).write_text(json.dumps(content, indent=2)+'\n')
    print(json.dumps(summary, indent=2))


if __name__ == '__main__':
    main()
