#!/usr/bin/env python3
import argparse
import datetime
import gzip
import hashlib
import json
import os
import pathlib
import re
import subprocess

root = pathlib.Path(__file__).resolve().parents[1]
archive = root / 'findings/policy-switch-time-v1'
names = ['control-1', 'switch-1', 'switch-2', 'control-2']


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def summarize(records, corpus):
    assert set(records) == set(names)
    assert len({r['manifest']['binary_sha256'] for r in records.values()}) == 1
    assert len({json.dumps(r['manifest']['source_hashes']) for r in records.values()}) == 1
    assert len({r['manifest']['dex_fingerprint'] for r in records.values()}) == 1
    assert all(r['manifest']['corpus_sha256'] == sha(corpus) for r in records.values())
    old_path = root / 'findings/policy-switch-reuse-v1/records.json.gz'
    old = json.loads(gzip.decompress(old_path.read_bytes()))['control']
    config = records[names[0]]['config']
    expected = dict(old['config'], time_budget_ms=30000, work_budget=100_000_000)
    if 'switch_kernel_capacity' in config:
        expected['switch_kernel_capacity'] = 0
    if 'frontier_mass_order' in config:
        expected['frontier_mass_order'] = False
    assert config == expected
    results = {}
    for name in names:
        record = records[name]
        capacity = config['healing_capacity']
        assert record['config'] == dict(config, reuse_switches=name.startswith('switch'))
        assert record['schema'] == old['schema'] and record['state_key'] == old['state_key']
        report = record['report']
        assert report['time_exhausted'] and report['runs'] < config['work_budget']
        assert config['time_budget_ms'] <= report['elapsed_ms'] <= config['time_budget_ms'] + 5000
        cache = report['healing_cache']
        assert cache['observations'] == cache['runs'] + cache['hits']
        boom = report['boom_eager']
        assert cache['runs'] + boom['runs'] == report['runs']
        assert boom['completed'] <= boom['attempts']
        assert boom['terminal_replacements'] <= boom['runs']
        assert boom['terminal_replacements'] == 0
        assert cache['switch_hits'] <= cache['switch_eligible'] <= cache['eligible']
        if name.startswith('control'):
            assert cache['switch_hits'] == cache['switch_eligible'] == 0
        assert cache['attack_hits'] <= cache['attack_eligible'] <= cache['eligible']
        assert cache['reset_hits'] <= cache['hits'] - cache['attack_hits'] - cache['switch_hits']
        assert sum(cache['exclusions'].values()) + cache['eligible'] == cache['observations']
        assert cache['hits'] + cache['rejected_hp'] <= cache['eligible'] <= cache['observations']
        assert cache['peak_entries'] <= capacity
        previous = dict(runs=0, wins=0, ties=0, losses=0, dropped_mass=0, failed_mass=0, score=dict(lo=0, hi=1))
        for depth, row in enumerate(report['layers'], 1):
            assert row['depth'] == depth and row['runs'] <= config['work_budget']
            assert 0 <= row['frontier_templates'] <= min(row['frontier_states'], config['width'])
            assert row['frontier_states'] <= config['packed_state_cap']
            assert abs(row['unknown_mass'] - sum(row[k] for k in ['dropped_mass', 'failed_mass', 'frontier_mass'])) < 1e-12
            assert abs(sum(row[k] for k in ['wins', 'ties', 'losses', 'unknown_mass']) - 1) < 1e-9
            for key in ['runs', 'wins', 'ties', 'losses', 'dropped_mass', 'failed_mass']:
                assert row[key] >= previous[key]
            assert row['score']['lo'] >= previous['score']['lo'] - 1e-12
            assert row['score']['hi'] <= previous['score']['hi'] + 1e-12
            pad = report['numerical_envelope']
            assert row['score']['lo'] == max(0, row['wins'] + .5 * row['ties'] - pad)
            assert row['score']['hi'] == min(1, row['wins'] + .5 * row['ties'] + row['unknown_mass'] + pad)
            previous = row
        assert report['score'] == previous['score'] and report['runs'] == previous['runs']
        results[name] = dict(score=report['score'], runs=report['runs'], elapsed_ms=report['elapsed_ms'], cache=cache, boom_eager=boom,
                             hit_fraction=cache['hits'] / max(1, cache['observations']),
                             peak_states=report['peak_frontier'], peak_templates=report['peak_templates'],
                             depth=len(report['layers']), final=previous)
    comparisons = {}
    for trial in [1, 2]:
        control, switch = [results[f'{arm}-{trial}'] for arm in ['control', 'switch']]
        comparisons[str(trial)] = dict(upper_reduction=control['score']['hi']-switch['score']['hi'],
            elapsed_ratio=switch['elapsed_ms']/control['elapsed_ms'],
            engine_runs_ratio=switch['runs']/control['runs'])
    return dict(schema='nc2000-policy-switch-time-v1', results=results, comparisons=comparisons,
                prior_archive_sha256=sha(old_path.read_bytes()),
                interpretation='Serial control/switch/switch/control runs use the same 30-second limit and nonbinding engine-execution budget. The deadline is checked between input states; each current cell and final mass accounting finish before elapsed time is recorded. Unprocessed probability stays unknown. Two reversed-order pairs diagnose whether voluntary-switch reuse improves the fixed-policy-pair interval per wall time on this workload; they do not establish general speedup, unrestricted game value or deployed strength.')



def summarize_profile(record, raw, reference):
    assert record['manifest'] == reference['manifest'] and record['config'] == reference['config']
    sample = raw.decode()
    threads = re.findall(r'^\s+(\d+) Thread_', sample, re.M)
    assert len(threads) == 1
    total = int(threads[0])
    tail = sample.split('Sort by top of stack, same collapsed (when >= 5):\n')[1].split('Binary Images:')[0]
    selected = []
    for line in tail.splitlines():
        match = re.match(r'\s*(\S+)\s+\(in [^)]+\)\s+(\d+)\s*$', line)
        if match:
            symbol = match[1]
            if 'state_key128_with' in symbol or 'state_hash_into' in symbol or ('Sip13Rounds' in symbol and 'write' in symbol):
                selected.append(dict(symbol=symbol, samples=int(match[2])))
    assert len(selected) == 3
    return dict(schema='nc2000-policy-switch-profile-v1', sample_sha256=sha(raw), duration_seconds=10, interval_ms=1,
                main_thread_samples=total, selected_top_of_stack=selected,
                selected_fraction=sum(r['samples'] for r in selected)/total,
                interpretation='Separate sampled run, excluded from timed comparisons. The three disjoint top-of-stack groups identify state-key traversal and SipHash write work in the first ten seconds. Sampling proportions are a workload diagnostic, not exact CPU accounting or a guaranteed optimization gain.')


parser = argparse.ArgumentParser()
mode = parser.add_mutually_exclusive_group()
mode.add_argument('--verify-only', action='store_true')
mode.add_argument('--record-existing', type=pathlib.Path)
args = parser.parse_args()
if args.verify_only:
    records = json.loads(gzip.decompress((archive / 'records.json.gz').read_bytes()))
    corpus = gzip.decompress((archive / 'corpus.jsonl.gz').read_bytes())
    assert all(records[name]['config'] == json.loads((archive / f'{name}.json').read_bytes()) for name in names)
    assert summarize(records, corpus) == json.loads((archive / 'summary.json').read_bytes())
    profile_raw = gzip.decompress((archive / 'profile.txt.gz').read_bytes())
    profile_record = json.loads(gzip.decompress((archive / 'profile-result.json.gz').read_bytes()))
    assert summarize_profile(profile_record, profile_raw, records['switch-1']) == json.loads((archive / 'profile.json').read_bytes())
    print('Verified matched time limits, conservative intervals and separate sampling evidence')
    raise SystemExit(0)
directory = args.record_existing
if directory is None:
    directory = root / 'tmp/policy-switch-time-v1' / datetime.datetime.now().strftime('run-%Y%m%d-%H%M%S')
    directory.mkdir(parents=True)
    (directory / 'corpus.jsonl').write_bytes(gzip.decompress((archive / 'corpus.jsonl.gz').read_bytes()))
    env = dict(os.environ, NC2000_REPO_ROOT=str(root))
    subprocess.run(['cargo', 'build', '--release', '-p', 'nc2000-bot', '--example', 'fixed_reply_counterpolicy'], cwd=root, env=env, check=True)
    command = [str(root / 'target/release/examples/fixed_reply_counterpolicy'), str(directory / 'corpus.jsonl')]
    for name in names:
        (directory / f'{name}.json').write_bytes((archive / f'{name}.json').read_bytes())
        subprocess.run(command + ['certify', str(directory / f'{name}.json'), str(directory / f'{name}-result.json')], cwd=root, env=env, check=True)
    with (directory / 'profile-run.log').open('w') as log:
        process = subprocess.Popen(command + ['certify', str(directory / 'switch-1.json'), str(directory / 'profile-result.json')], cwd=root, env=env, stdout=log, stderr=subprocess.STDOUT)
        subprocess.run(['sample', str(process.pid), '10', '1', '-mayDie', '-file', str(directory / 'sample.txt')], check=True)
        assert process.wait() == 0
records = {name: json.loads((directory / f'{name}-result.json').read_bytes()) for name in names}
corpus = (directory / 'corpus.jsonl').read_bytes()
summary = summarize(records, corpus)
profile_raw = (directory / 'sample.txt').read_bytes()
profile_record = json.loads((directory / 'profile-result.json').read_bytes())
profile = summarize_profile(profile_record, profile_raw, records['switch-1'])
if args.record_existing:
    archive.mkdir(exist_ok=True)
    (archive / 'corpus.jsonl.gz').write_bytes(gzip.compress(corpus, mtime=0))
    (archive / 'records.json.gz').write_bytes(gzip.compress(json.dumps(records, separators=(',', ':')).encode(), mtime=0))
    for name in names:
        (archive / f'{name}.json').write_bytes((directory / f'{name}.json').read_bytes())
    (archive / 'summary.json').write_text(json.dumps(summary, indent=2) + '\n')
    (archive / 'profile.txt.gz').write_bytes(gzip.compress(profile_raw, mtime=0))
    (archive / 'profile-result.json.gz').write_bytes(gzip.compress(json.dumps(profile_record, separators=(',', ':')).encode(), mtime=0))
    (archive / 'profile.json').write_text(json.dumps(profile, indent=2) + '\n')
for name, row in summary['results'].items():
    print(name, json.dumps(row))
