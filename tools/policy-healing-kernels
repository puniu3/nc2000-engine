#!/usr/bin/env python3
import argparse
import datetime
import gzip
import hashlib
import json
import os
import pathlib
import subprocess

root = pathlib.Path(__file__).resolve().parents[1]
archive = root / 'findings/policy-healing-kernels-v1'
names = ['control-work', 'healing-work', 'control-1', 'healing-1', 'healing-2', 'control-2']


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def summarize(records, corpus):
    assert set(records) == set(names)
    assert len({r['manifest']['binary_sha256'] for r in records.values()}) == 1
    assert len({json.dumps(r['manifest']['source_hashes']) for r in records.values()}) == 1
    assert len({r['manifest']['dex_fingerprint'] for r in records.values()}) == 1
    assert all(r['manifest']['corpus_sha256'] == sha(corpus) for r in records.values())
    old_path = root / 'findings/policy-best-first-v1/records.json.gz'
    old = json.loads(gzip.decompress(old_path.read_bytes()))['control-work']
    config = records[names[0]]['config']
    assert config == dict(old['config'], healing_kernel_capacity=0)
    baseline = records['control-work']['report']
    for key, value in old['report'].items():
        if key == 'healing_cache':
            assert all(baseline[key][field] == count for field, count in value.items())
        elif key != 'elapsed_ms':
            assert baseline[key] == value, key
    results = {}
    for name in names:
        record = records[name]
        capacity = config['healing_capacity']
        timed = not name.endswith('work')
        kernel_capacity = config['switch_kernel_capacity']
        assert record['config'] == dict(config, healing_kernel_capacity=4096 if name.startswith('healing') else 0, time_budget_ms=30000 if timed else 0, work_budget=100_000_000 if timed else 2_000_000)
        assert record['schema'] == old['schema'] and record['state_key'] == old['state_key']
        report = record['report']
        if timed:
            assert report['time_exhausted'] and report['runs'] < record['config']['work_budget']
            assert 30000 <= report['elapsed_ms'] <= 35000
        else:
            assert not report['time_exhausted'] and report['runs'] == 2_000_000
        order = report['frontier_order']
        assert len(order) == len(report['layers'])
        previous_frontier = 1.0
        for depth, row in enumerate(order, 1):
            assert row['depth'] == depth
            assert 0 <= row['processed_states'] <= row['input_states']
            assert 0 <= row['processed_mass'] <= row['top_mass_same_count'] + 1e-12
            assert row['top_mass_same_count'] <= row['input_mass'] + 1e-12
            assert abs(row['input_mass'] - previous_frontier) < 1e-12
            assert abs(row['processed_mass'] - row['top_mass_same_count']) < 1e-12
            previous_frontier = report['layers'][depth-1]['frontier_mass']
        kernels = report['switch_kernels']
        healing_kernels = report['healing_kernels']
        assert healing_kernels['hits'] + healing_kernels['rejected_hp'] <= healing_kernels['eligible'] <= healing_kernels['calls']
        assert healing_kernels['calls'] == kernels['calls'] + healing_kernels['hits']
        assert healing_kernels['reset_leaves'] <= healing_kernels['translated_leaves'] <= healing_kernels['observations_avoided']
        assert healing_kernels['peak_leaves'] <= record['config']['healing_kernel_capacity']
        if name.startswith('control'):
            assert healing_kernels['eligible'] == healing_kernels['hits'] == healing_kernels['observations_avoided'] == 0
        assert kernels['hits'] <= kernels['eligible'] <= kernels['calls']
        assert kernels['peak_leaves'] <= kernel_capacity
        if not kernel_capacity:
            assert kernels['eligible'] == kernels['hits'] == kernels['observations_avoided'] == 0
        cache = report['healing_cache']
        assert cache['observations'] == cache['runs'] + cache['hits']
        boom = report['boom_eager']
        assert cache['runs'] + boom['runs'] == report['runs']
        assert boom['completed'] <= boom['attempts']
        assert boom['terminal_replacements'] <= boom['runs']
        assert boom['terminal_replacements'] == 0
        assert cache['switch_hits'] <= cache['switch_eligible'] <= cache['eligible']
        assert cache['attack_hits'] <= cache['attack_eligible'] <= cache['eligible']
        assert cache['reset_hits'] <= cache['hits'] - cache['attack_hits'] - cache['switch_hits']
        assert sum(cache['exclusions'].values()) + cache['eligible'] == cache['observations']
        assert cache['hits'] + cache['rejected_hp'] <= cache['eligible'] <= cache['observations']
        assert cache['peak_entries'] <= capacity
        previous = dict(runs=0, wins=0, ties=0, losses=0, dropped_mass=0, failed_mass=0, score=dict(lo=0, hi=1))
        for depth, row in enumerate(report['layers'], 1):
            assert row['depth'] == depth and row['runs'] <= record['config']['work_budget']
            assert 0 <= row['frontier_templates'] <= min(row['frontier_states'], config['width'])
            assert row['frontier_states'] <= config['packed_state_cap']
            assert abs(row['unknown_mass'] - sum(row[k] for k in ['dropped_mass', 'failed_mass', 'frontier_mass'])) < 1e-12
            assert abs(sum(row[k] for k in ['wins', 'ties', 'losses', 'unknown_mass']) - 1) < 1e-9
            for key in ['runs', 'wins', 'ties', 'losses', 'dropped_mass', 'failed_mass']:
                assert row[key] >= previous[key]
            assert row['score']['lo'] >= previous['score']['lo'] - 1e-12
            assert row['score']['hi'] <= previous['score']['hi'] + 1e-12
            pad = report['numerical_envelope']
            assert row['score']['lo'] == max(0, row['wins'] + .5 * row['ties'] - pad)
            assert row['score']['hi'] == min(1, row['wins'] + .5 * row['ties'] + row['unknown_mass'] + pad)
            previous = row
        assert report['score'] == previous['score'] and report['runs'] == previous['runs']
        results[name] = dict(score=report['score'], runs=report['runs'], elapsed_ms=report['elapsed_ms'], cache=cache, boom_eager=boom, switch_kernels=kernels, healing_kernels=healing_kernels, frontier_order=order,
                             hit_fraction=cache['hits'] / max(1, cache['observations']),
                             peak_states=report['peak_frontier'], peak_templates=report['peak_templates'],
                             depth=len(report['layers']), final=previous)
    comparisons = {}
    for trial in [1, 2]:
        control, switch = [results[f'{arm}-{trial}'] for arm in ['control', 'healing']]
        comparisons[str(trial)] = dict(upper_reduction=control['score']['hi']-switch['score']['hi'],
            elapsed_ratio=switch['elapsed_ms']/control['elapsed_ms'],
            engine_runs_ratio=switch['runs']/control['runs'])
    comparisons['work'] = dict(upper_reduction=results['control-work']['score']['hi']-results['healing-work']['score']['hi'])
    return dict(schema='nc2000-policy-healing-kernels-v1', results=results, comparisons=comparisons,
                prior_archive_sha256=sha(old_path.read_bytes()),
                interpretation='Aggregated healing kernels use the existing strictly-faster, below-full-HP healer admission domain. Every stored source successor must be nonterminal with both original actives surviving. Rest-reset HP is retained; non-reset HP translates by the source damage, guarded by the maximum required HP across all stored leaves. A failed guard falls back to ordinary enumeration. Script caps and unresolved probability remain unchanged. Ninety direct probability-map comparisons cover both sides, awake/waking Rest, Sleep Talk, low/full HP, and partial caps; separate cases cover eviction, disabled storage and terminal-source rejection. The control reproduces all prior fixed-work report fields. Two fixed-work arms precede control/healing/healing/control 30-second runs. These are fixed-policy-pair intervals, not unrestricted game value or deployed strength.')



parser = argparse.ArgumentParser()
mode = parser.add_mutually_exclusive_group()
mode.add_argument('--verify-only', action='store_true')
mode.add_argument('--record-existing', type=pathlib.Path)
args = parser.parse_args()
if args.verify_only:
    records = json.loads(gzip.decompress((archive / 'records.json.gz').read_bytes()))
    corpus = gzip.decompress((archive / 'corpus.jsonl.gz').read_bytes())
    assert all(records[name]['config'] == json.loads((archive / f'{name}.json').read_bytes()) for name in names)
    assert summarize(records, corpus) == json.loads((archive / 'summary.json').read_bytes())
    print('Verified baseline parity, healing-kernel accounting, matched budgets and conservative intervals')
    raise SystemExit(0)
directory = args.record_existing
if directory is None:
    directory = root / 'tmp/policy-healing-kernels-v1' / datetime.datetime.now().strftime('run-%Y%m%d-%H%M%S')
    directory.mkdir(parents=True)
    (directory / 'corpus.jsonl').write_bytes(gzip.decompress((archive / 'corpus.jsonl.gz').read_bytes()))
    env = dict(os.environ, NC2000_REPO_ROOT=str(root))
    subprocess.run(['cargo', 'build', '--release', '-p', 'nc2000-bot', '--example', 'fixed_reply_counterpolicy'], cwd=root, env=env, check=True)
    command = [str(root / 'target/release/examples/fixed_reply_counterpolicy'), str(directory / 'corpus.jsonl')]
    for name in names:
        (directory / f'{name}.json').write_bytes((archive / f'{name}.json').read_bytes())
        subprocess.run(command + ['certify', str(directory / f'{name}.json'), str(directory / f'{name}-result.json')], cwd=root, env=env, check=True)
records = {name: json.loads((directory / f'{name}-result.json').read_bytes()) for name in names}
corpus = (directory / 'corpus.jsonl').read_bytes()
summary = summarize(records, corpus)
if args.record_existing:
    archive.mkdir(exist_ok=True)
    (archive / 'corpus.jsonl.gz').write_bytes(gzip.compress(corpus, mtime=0))
    (archive / 'records.json.gz').write_bytes(gzip.compress(json.dumps(records, separators=(',', ':')).encode(), mtime=0))
    for name in names:
        (archive / f'{name}.json').write_bytes((directory / f'{name}.json').read_bytes())
    (archive / 'summary.json').write_text(json.dumps(summary, indent=2) + '\n')
for name, row in summary['results'].items():
    print(name, json.dumps(row))
