#!/usr/bin/env python3
"""Audit the frozen small SMAB screen and render its local preview report."""
import collections
import hashlib
import html
import json
import math
from pathlib import Path
import statistics

ROOT = Path(__file__).resolve().parents[1]
OUT = ROOT / 'findings/smab-screen-v1'


def audit(rows):
    groups = collections.defaultdict(list)
    for row in rows:
        groups[(row['root'], tuple(row['ks']), row['mode'])].append(row)
    assert len(rows) == 162
    assert len(groups) == 54
    cases = []
    max_error = max_gap = 0.0
    for root, ks in sorted({(r['root'], tuple(r['ks'])) for r in rows}):
        arms = {}
        reference = groups[root, ks, 'Full'][0]
        for mode in ['Full', 'Do', 'DoAb']:
            repeats = sorted(groups[root, ks, mode], key=lambda r: r['repeat'])
            assert [r['repeat'] for r in repeats] == [0, 1, 2]
            complete = all(r['status'] == 'Complete' for r in repeats)
            arms[mode] = {'complete': complete, 'ms': statistics.median(r['ms'] for r in repeats),
                          'runs': repeats[0]['counts']['runs'], 'counts': repeats[0]['counts'],
                          'statuses': [r['status'] for r in repeats]}
            if not complete:
                continue
            assert all(r['counts'] == repeats[0]['counts'] for r in repeats)
            assert all(abs(r['value'] - repeats[0]['value']) < 1e-12 for r in repeats)
            if reference['status'] != 'Complete':
                continue
            a = reference['matrix']
            for r in repeats:
                x, y = r['x'], r['y']
                for p in [x, y]:
                    assert all(math.isfinite(v) and v >= 0 for v in p)
                    assert abs(sum(p) - 1) < 1e-12
                lo = min(sum(x[i] * a[i * len(y) + j] for i in range(len(x))) for j in range(len(y)))
                hi = max(sum(y[j] * a[i * len(y) + j] for j in range(len(y))) for i in range(len(x)))
                error, gap = abs(r['value'] - reference['value']), hi - lo
                assert error < 1e-7 and gap < 1e-7
                assert lo - 1e-7 <= r['value'] <= hi + 1e-7
                assert lo - 1e-7 <= reference['value'] <= hi + 1e-7
                assert abs(error - r['reference_error']) < 1e-12
                assert abs(gap - r['reference_policy_gap']) < 1e-12
                max_error, max_gap = max(max_error, error), max(max_gap, gap)
        cases.append({'root': root, 'ks': ks, 'position': reference['position'], 'arms': arms})
    aggregate = []
    for depth, expected in [(2, 12), (3, 6)]:
        selected = [c for c in cases if len(c['ks']) == depth]
        assert len(selected) == expected
        for mode in ['Do', 'DoAb']:
            pairs = [(c['arms']['Full'], c['arms'][mode]) for c in selected]
            complete = all(a['complete'] and b['complete'] for a, b in pairs)
            ratios = [a['ms'] / b['ms'] for a, b in pairs if a['complete'] and b['complete']]
            gm = math.exp(statistics.mean(math.log(r) for r in ratios)) if ratios else None
            faster = sum(r > 1 for r in ratios)
            aggregate.append({'depth': depth, 'mode': mode, 'roots': expected, 'complete': complete,
                              'geomean_speedup': gm, 'faster_roots': faster,
                              'total_time_ratio_candidate_over_full': sum(b['ms'] for a, b in pairs) / sum(a['ms'] for a, b in pairs),
                              'total_runs_ratio_candidate_over_full': sum(b['runs'] for a, b in pairs) / sum(a['runs'] for a, b in pairs),
                              'primary_gate_pass': depth == 2 and complete and gm >= 1.5 and faster / expected >= .75})
    ab_increment = {}
    for depth in [2, 3]:
        selected = [c for c in cases if len(c['ks']) == depth]
        ab_increment[str(depth)] = math.exp(statistics.mean(math.log(c['arms']['Do']['ms'] / c['arms']['DoAb']['ms']) for c in selected))
    baseline_mixed = {}
    for depth in [2, 3]:
        selected = [r for r in rows if r['mode'] == 'Full' and r['repeat'] == 0 and len(r['ks']) == depth and r['status'] == 'Complete']
        baseline_mixed[str(depth)] = sum(any(sum(p > 1e-8 for p in r[side]) > 1 for side in ['x', 'y']) for r in selected)
    return {'cases': cases, 'aggregate': aggregate, 'ab_increment_over_do': ab_increment,
            'baseline_roots_with_mixing': baseline_mixed, 'max_value_error': max_error,
            'max_root_policy_gap': max_gap, 'go': any(a['primary_gate_pass'] for a in aggregate),
            'scope': 'Current operational engine, 12 generated low-budget self-play games. Fixed sampled perfect-information games and eval01 leaves. Same sample seed across repeats: repeats measure timing, not statistical accuracy. No MCTS strength comparison. A failed screen rejects progression of these implementations, not all alpha-beta algorithms.'}


def main():
    rows = [json.loads(l) for l in (OUT / 'rows.jsonl').read_text().splitlines()]
    result = audit(rows)
    # Negative control: a changed payoff must be rejected, not merely trusted
    # because the producing executable reported a small error.
    bad = json.loads(json.dumps(rows))
    first = next(r for r in bad if r['mode'] == 'Full' and r['repeat'] == 0 and 'matrix' in r)
    first['matrix'] = [v + .1 for v in first['matrix']]
    try:
        audit(bad)
    except AssertionError:
        pass
    else:
        raise AssertionError('corrupted reference matrix accepted')
    result['corrupt_matrix_rejected'] = True
    paths = ['crates/bot/examples/smab_screen.rs', 'tools/smab-screen-report',
             'findings/smab-screen-v1/protocol.json', 'findings/smab-screen-v1/roots.json',
             'findings/smab-screen-v1/rows.jsonl', 'findings/smab-screen-v1/games.jsonl.gz',
             'findings/smab-screen-v1/validation.json',
             'data/gen2stadium2.json', 'data/belief-pool-v3/belief-pool.json',
             'data/team-pool-v2/team-pool.json']
    result['sha256'] = {p: hashlib.sha256((ROOT / p).read_bytes()).hexdigest() for p in paths}
    (OUT / 'summary.json').write_text(json.dumps(result, indent=2, ensure_ascii=False) + '\n')
    verdict = '次の比較へ進む基準を満たした' if result['go'] else '今回の実装では、次へ進む基準を満たさなかった'
    tr = ''.join(f'<tr><td>{a["depth"]}</td><td>{a["mode"]}</td><td>{a["geomean_speedup"]:.2f}倍</td><td>{a["faster_roots"]}/{a["roots"]}</td><td>{a["total_runs_ratio_candidate_over_full"]:.1%}</td></tr>' for a in result['aggregate'])
    detail = ''.join(f'<tr><td>{c["root"]}</td><td>{len(c["ks"])}</td><td>{html.escape(str(c["position"]["alive"]))}</td>' + ''.join(f'<td>{c["arms"][m]["ms"]:.1f}</td>' for m in ['Full','Do','DoAb']) + '</tr>' for c in result['cases'])
    page = f'''<!doctype html><html lang="ja"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>NC2000 αβ 小規模比較</title>
<style>body{{font:17px/1.8 system-ui,sans-serif;background:#f4f1e9;color:#252b26;max-width:900px;margin:40px auto;padding:0 20px}}h1{{font-size:1.7rem}}h2{{font-size:1.2rem}}table{{border-collapse:collapse;width:100%;font-size:.95rem}}td,th{{padding:10px;text-align:right;border-bottom:1px solid #cbcfc5}}td:first-child,th:first-child{{text-align:left}}a{{color:#35604d}}.verdict{{padding:18px;background:#e5eade;border-radius:8px}}.scroll{{overflow:auto}}small{{color:#535950}}</style>
<h1>αβ系探索の小規模比較</h1><p class="verdict">{verdict}</p>
<p>現行エンジンで生成した12対局から、残り2体・3〜4体・5〜6体の各4局面を事前選択。深さ2は12局面（各行動組合せ4×4サンプル）、深さ3はそのうち6局面（2×2×2サンプル）。各3回、実行順を交代し、中央値を比較しました。</p>
<p>Full：全行動を展開する行列探索。Do：少数候補から最善応答を追加する探索。DoAb：Doに、手番を直列化したαβ探索の上下界と確率分岐の打ち切りを追加。候補の順序づけも実行時間に含みます。</p>
<p>事前基準：深さ2の幾何平均で1.5倍以上、かつ75%以上の局面で高速化し、全局面完了・値と方策の検証に合格すること。深さ3は補助確認です。</p>
<div class="scroll"><table><tr><th>深さ</th><th>方式</th><th>速度比 Full/候補</th><th>速い局面</th><th>エンジン実行数比</th></tr>{tr}</table></div>
<p>αβの追加分だけを比べても、DoAbはDoより深さ2で{result['ab_increment_over_do']['2']:.2f}倍、深さ3で{result['ab_increment_over_do']['3']:.2f}倍高速でした。混合戦略が必要だった基準局面は深さ2で{result['baseline_roots_with_mixing']['2']}/12、深さ3で{result['baseline_roots_with_mixing']['3']}/6です。</p>
<h2>正しさと範囲</h2><p>乱数は局面・残り深さ・行動組合せ・サンプル番号に固定。探索順が変わっても同じ有限ゲームです。最大値差 {result['max_value_error']:.3g}、基準行列での最大方策ギャップ {result['max_root_policy_gap']:.3g}（許容1e-7）。40個の人工確率ゲームで上下界・窓付き探索・再開を検証し、改ざんした基準行列が監査を通らないことも確認しました。</p>
<p>初回の実行は共通の行列ソルバーが返す上下界の幅0.0094を検出して停止し、途中の測定値を判定から除外しました。実験用に限り、既存ソルバーの誤差幅が1e-8以上なら小行列の頂点列挙に切り替え、全行動に対する方策の保証を検証する共通処理を追加。同じ局面・条件で全測定を再実行し、その追加費用も含めています。</p>
<p>これは計算効率の測定です。乱数の全列挙や真のゲーム値の証明、MCTSとの対戦強度比較ではありません。葉は既存eval01、隠れ情報は既知として固定しています。3回の反復は速度の反復で、別の乱数ゲームではありません。古い対局アーカイブは再生識別子が合わず採用せず、現在の通常ルールで新規生成した対局のみ使用しました。</p>
<h2>局面別の時間（ミリ秒）</h2><div class="scroll"><table><tr><th>局面</th><th>深さ</th><th>残り体数</th><th>Full</th><th>Do</th><th>DoAb</th></tr>{detail}</table></div>
<p><a href="protocol.json">事前条件</a> · <a href="summary.json">集計とファイル識別子</a> · <a href="roots.json">対象局面</a> · <a href="rows.jsonl">全測定値</a> · <a href="validation.json">検証・再現コマンド</a></p><small>共有プレビューハブの項目：nc2000-smab-screen。製品コードと公開サイトへの変更はありません。</small></html>'''
    (OUT / 'index.html').write_text(page)
    print(json.dumps({k: v for k, v in result.items() if k not in ['cases', 'sha256']}, indent=2))


if __name__ == '__main__':
    main()
