#!/usr/bin/env python3
import argparse
import copy
import gzip
import hashlib
import json
import runpy
from fractions import Fraction as F
from pathlib import Path

root = Path(__file__).resolve().parents[1]
archive = root / 'findings/item-move-product-v1'
ledger_check = runpy.run_path(str(root / 'tools/policy-witness-probe'))['verify']
policy_check = runpy.run_path(str(root / 'tools/hidden-move-witness-probe'))['check_policy']


def ident(text):
    return ''.join(c.lower() for c in text if c.isalnum())


def screen_check(screen, repeat, previous, family, game):
    assert screen == repeat
    items = previous['same_history_items']
    moves = ['rest'] + sorted({r['move'] for r in family['rows']} - {'rest'}) + ['<empty>']
    assert len(items) == 55 and len(moves) == 40
    assert len(screen['rows']) == 2200
    case = screen['case']
    assert (case['game'], case['decision'], case['side'], case['foe_slot']) == (6, 32, 1, 5)
    assert screen['observation']['item'] == 'ItemObs { original: None, current: None, gained: false }'
    assert screen['observation']['moves'] == ['thunderbolt', 'hiddenpowerice', 'sleeptalk']
    assert screen['observation']['preview_has_item']
    expected = []
    for item in items:
        for move in moves:
            slots = ['thunderbolt', 'hiddenpowerice'] + ([] if move == '<empty>' else [move]) + ['sleeptalk']
            swap = next((i for i, m in enumerate(game['teams'][0]) if i != 5 and ident(m['item']) == item), None)
            expected.append(dict(id=f'{item}/{move}', kind='product', patch=dict(item=item, moves=slots), swapped_slot=swap))
    for row, request in zip(screen['rows'], expected):
        assert row['request'] == request and row['validity']['ok']
        assert row['prefix_checks'] == 33 and 'mismatch' not in row
        state = row['root']
        assert state['log_hash'] == case['log_hash'] and state['observer_hash'] == case['observer_hash']
        assert state['item'] == request['patch']['item']
        assert state['stats'] == [141, 134, 176, 141, 151] and state['hp'] == state['maxhp'] == 196
        assert state['ivs'] == [30, 30, 26, 30, 30, 30] and state['evs'] == [255]*6
        assert state['hp_type'] == 'Ice' and state['hp_power'] == 70
        active = next(p for p in state['state']['sides'][0]['pokemon'] if p['active'])
        assert [m['id'] for m in active['moves']] == request['patch']['moves']
    assert len({r['root']['key'] for r in screen['rows']}) == 2200
    return items, moves


def check_row(row, reference, cfg):
    assert row['id'] == reference['request']['id'] and row['seconds'] >= 0
    p, target = F(cfg['p']), F(cfg['target'])
    reports = {}
    for first in ['swordsdance', 'rockslide']:
        ledger = row[first]
        if ledger is None:
            assert first == 'rockslide'
            continue
        expected = dict(game=6, decision=32, target_side=1, policy_side=1, first_choice='move '+first,
            priority=['move rockslide'], rest_at_percent=None, horizon=2, work_budget=200000,
            cell_cap=10000, guarded_keys=True, support_certificate=True)
        assert ledger['config'] == expected
        assert ledger['nodes'][-1]['state_key'] == reference['root']['key']
        report = ledger_check(ledger)
        policy_check(ledger)
        reports[first] = report
    sword = F(row['swordsdance']['bounds'][0])
    rock = F(row['rockslide']['bounds'][0]) if row['rockslide'] else F(0)
    lower = p*rock+(1-p)*sword
    assert abs(lower-F(row['mixed_lower'])) < F(1, 10**14)
    needed = min(1., max(0., (cfg['target']+1e-9-(1.-cfg['p'])*float(sword))/cfg['p']))
    assert row['rockslide_threshold'] == needed
    if row['rockslide'] is None:
        assert (1-p)*sword > target
    assert lower >= target
    return lower, reports


def verify(screen, repeat, config, rows, replays, previous, family, prior_records, game):
    items, moves = screen_check(screen, repeat, previous, family, game)
    assert config['kind'] == 'config' and config['case'] == screen['case']
    assert config['first'] == 0 and config['count'] == len(rows) == 2200
    assert config['p'] == previous['finite_family']['rockslide_probability']
    assert config['target'] == previous['finite_family']['lower']-1e-6
    assert 0 < config['p'] < 1 and 0 < config['target'] < 1
    values, work, reports = [], [], []
    for index, (row, reference) in enumerate(zip(rows, screen['rows'])):
        assert row['index'] == index
        value, checked = check_row(row, reference, config)
        values.append(value)
        work.append(sum(r['runs'] for r in checked.values()))
        reports += list(checked.values())
    expected_ids = ['brightpowder/doubleedge', 'brightpowder/drillpeck', 'focusband/doubleedge',
        'focusband/drillpeck', 'focusband/substitute', 'przcureberry/rest', 'quickclaw/snore']
    expected_ids = list(dict.fromkeys(expected_ids + [rows[max(range(len(rows)), key=lambda i: work[i])]['id']]))
    assert [r[1]['id'] for r in replays] == expected_ids
    for header, row in replays:
        index = row['index']
        assert header == dict(config, first=index, count=1)
        assert {k: v for k, v in row.items() if k != 'seconds'} == {k: v for k, v in rows[index].items() if k != 'seconds'}
    upper_worlds = previous['finite_family']['adversary_worlds']
    upper_rows = [next(r for r in prior_records['data'][2]['rows'] if r['request']['id'] == world) for world in upper_worlds]
    action_bounds = []
    for world, prior in zip(upper_worlds, upper_rows):
        item = world.split('/')[-1]
        reference = next(r for r in screen['rows'] if r['request']['id'] == item+'/doubleedge')
        assert prior['root']['key'] == reference['root']['key']
        ledger = next(r['ledger'] for r in prior['ledgers'] if r['first'] == 'sleeptalk')
        ledger_check(ledger)
        policy_check(ledger)
        assert ledger['config']['target_side'] == ledger['config']['policy_side'] == 0
        assert ledger['config']['opening'] == ['move sleeptalk', 'move sleeptalk', 'move hiddenpowerice']
        action_bounds.append({b['choices'][1]: F(1-b['bounds'][0]) for b in ledger['nodes'][-1]['branches']})
    q = F(previous['finite_family']['adversary_probability_exact'])
    assert set(action_bounds[0]) == set(action_bounds[1]) == set(screen['case']['actions'])
    upper = max(q*v+(1-q)*action_bounds[1][a] for a, v in action_bounds[0].items())+F(1, 10**8)
    lower = min(values)-F(1, 10**8)
    assert 0 <= upper-lower < F(15, 10**6)
    assert abs(float(upper)-previous['finite_family']['upper']) < 1e-14
    pure_upper = max(min(bound[a] for bound in action_bounds) for a in action_bounds[0])
    return dict(items=55, moves_or_empty=40, worlds=2200, same_history_boundaries=72600,
        screening_repeat_identities=2200, repeated_proof_worlds=len(replays),
        repeated_certificates=sum(1+(r[1]['rockslide'] is not None) for r in replays),
        sword_certificates=2200, rock_certificates=sum(r['rockslide'] is not None for r in rows),
        rock_proofs_omitted=sum(r['rockslide'] is None for r in rows), total_engine_runs=sum(work),
        total_certificate_nodes=sum(r['nodes'] for r in reports),
        partial_branches=sum(r['partial_branches'] for r in reports),
        bounds=[float(lower), float(upper)], width=float(upper-lower),
        rockslide_probability=config['p'], prior_target=config['target'],
        smallest_lower_worlds=[rows[i]['id'] for i, v in enumerate(values) if v <= min(values)+F(1, 10**12)],
        best_pure_security_upper=float(pure_upper), mixed_gain_over_every_pure_lower=float(lower-pure_upper),
        upper_worlds=upper_worlds, production_changed=False, strength_demonstrated=False,
        scope='The Cartesian product of 55 item names previously witnessed by seeded replay and all '
              '40 legal fourth-move/empty-slot candidates at one fixed Zapdos/Marowak decision. Every '
              'one of 2200 teams passes native validation and reproduces all 33 public-history boundaries '
              'with the original seed and semantic choices. Stats, happiness and counter state stay fixed. '
              'This is not a complete information set: previous failures with this seed do not exclude '
              'other chance histories, and stat combinations are not covered. The first-action mix is '
              'fixed from the earlier 43-world analysis and is not retuned on this product. It uses a '
              'common Rock Slide continuation. Each two-step lower witness faces all replies; truncated '
              'mass remains [0,1]. An omitted Rock Slide witness uses the universal lower bound zero '
              'only when the Sword Dance contribution alone suffices. Rational backups and every policy '
              'action are checked. Seven boundary/control/heaviest worlds are replayed, with matching '
              'full certificates. The dual upper certificate reuses the two immutable item-world ledgers '
              'and their precommitted opponent policy, revalidated against generated model keys. Engine '
              'transitions and guarded-state identity remain trusted. The output is an offline proof '
              'of a restricted robust game, not an online runtime, full-game ceiling, human calibration '
              'or deployed-bot improvement.')


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--record', nargs=4, type=Path, metavar='INPUT')
    args = parser.parse_args()
    previous_path = root / 'findings/hidden-parameter-family-v1/summary.json'
    prior_path = root / 'findings/hidden-parameter-family-v1/records.json.gz'
    family_path = root / 'findings/hidden-move-family-v1/summary.json'
    corpus_path = root / 'findings/policy-gap-v1/corpus.jsonl.gz'
    previous = json.loads(previous_path.read_bytes())
    prior_records = json.loads(gzip.decompress(prior_path.read_bytes()))
    family = json.loads(family_path.read_bytes())
    game = next(json.loads(l) for l in gzip.decompress(corpus_path.read_bytes()).decode().splitlines() if json.loads(l)['game'] == 6)
    paths = [Path(__file__).resolve(), previous_path, prior_path, family_path, corpus_path,
        root / 'crates/bot/examples/item_move_product.rs', root / 'crates/bot/examples/hidden_parameter_family.rs',
        root / 'crates/bot/examples/threshold_witness/mod.rs', root / 'crates/bot/examples/policy_witness.rs',
        root / 'crates/bot/examples/hidden_terminal.rs', root / 'tools/policy-witness-probe',
        root / 'tools/hidden-move-witness-probe', root / 'data/gen2stadium2.json', root / 'data/learnsets-gen2.json']
    for directory in ['crates/bot/src', 'crates/engine/src']:
        paths += list((root / directory).rglob('*.rs'))
    hashes = {str(p.relative_to(root)): hashlib.sha256(p.read_bytes()).hexdigest() for p in paths}
    if args.record:
        assert not archive.exists()
        screen, repeat = [json.loads(p.read_bytes()) for p in args.record[:2]]
        proof_bytes = args.record[2].read_bytes()
        indices = json.loads(args.record[3].read_bytes())
        replays = [[json.loads(l) for l in Path(f'/tmp/nc-product-repeat-{i}.jsonl').read_text().splitlines()] for i in indices]
    else:
        bundle = json.loads(gzip.decompress((archive / 'records.json.gz').read_bytes()))
        assert bundle['hashes'] == hashes
        screen, repeat, replays = bundle['screen'], bundle['repeat'], bundle['replays']
        proof_bytes = gzip.decompress((archive / 'proofs.jsonl.gz').read_bytes())
        assert hashlib.sha256(proof_bytes).hexdigest() == bundle['proof_sha256']
    decoded = [json.loads(l) for l in proof_bytes.splitlines()]
    config, rows = decoded[0], decoded[1:]
    summary = verify(screen, repeat, config, rows, replays, previous, family, prior_records, game)
    for fault in ['missing_rock', 'inflated_value', 'wrong_root']:
        row = copy.deepcopy(next(r for r in rows if r['rockslide'] is not None))
        if fault == 'missing_rock':
            row['rockslide'] = None
        elif fault == 'inflated_value':
            row['swordsdance']['bounds'][0] += .01
        else:
            row['swordsdance']['nodes'][-1]['state_key'] = '0'
        try:
            check_row(row, screen['rows'][row['index']], config)
        except AssertionError:
            pass
        else:
            raise AssertionError(f'Accepted corruption: {fault}')
    report = dict(native_validated_worlds=2200, same_history_boundaries=72600,
        lower_certificates_verified=2530, upper_certificates_reverified=2,
        screening_repeat_identities=2200, repeated_proof_worlds=len(replays),
        negative_controls=['missing_rock', 'inflated_value', 'wrong_root'], production_changed=False)
    if args.record:
        archive.mkdir()
        bundle = dict(screen=screen, repeat=repeat, replays=replays, hashes=hashes,
            proof_sha256=hashlib.sha256(proof_bytes).hexdigest())
        (archive / 'records.json.gz').write_bytes(gzip.compress(json.dumps(bundle, separators=(',', ':')).encode(), mtime=0))
        (archive / 'proofs.jsonl.gz').write_bytes(gzip.compress(proof_bytes, mtime=0))
        for name, value in [('summary', summary), ('checks', report)]:
            (archive / (name + '.json')).write_text(json.dumps(value, indent=2) + '\n')
    else:
        assert summary == json.loads((archive / 'summary.json').read_bytes())
        assert report == json.loads((archive / 'checks.json').read_bytes())
    print(json.dumps({k: v for k, v in summary.items() if k != 'scope'}, indent=2))


if __name__ == '__main__':
    main()
