#!/usr/bin/env python3
import argparse
import copy
from fractions import Fraction as F
import gzip
import hashlib
import json
from pathlib import Path

root=Path(__file__).resolve().parents[1]
archive=root/'findings/hidden-move-family-v1'
old_path=root/'findings/hidden-move-witness-v1/records.json.gz'


def verify(out,case,summary,old):
    assert out['case']==case and out['prefix_checks']==33
    assert len(out['searches'])==64
    rows={(r['pinned'],r['seed'],r['variant']):r for r in out['searches']}
    keys={(p,0x2026110301+i,v) for p in [False,True] for i in range(16) for v in range(2)}
    assert set(rows)==keys
    previous={(r['pinned'],r['seed'],r['variant']):r for r in old['search']['searches']}
    for key,r in rows.items():
        assert sum(r['visits'])==27000 and len(r['visits'])==len(r['means'])==4
        assert all(n>=0 for n in r['visits']) and all(0<=v<=1 for v in r['means'])
        assert r['best'] in case['actions']
        if r['variant']==0:assert r==previous[key]
        if not r['pinned']:
            assert all(r[k]==rows[False,r['seed'],0][k] for k in ['best','visits','means','rng','nodes'])
    world=next(r for r in summary['rows'] if r['move']=='reflect');groups=[]
    for pinned in [False,True]:
        selections=[rows[pinned,0x2026110301+i,1] for i in range(16)]
        counts={a:sum(r['best']==a for r in selections) for a in case['actions']}
        losses=[max(F(0),F(world['game_bounds'][0])-F(world['upper'][r['best']])-F(1,10**8)) for r in selections]
        groups.append(dict(pinned=pinned,choices={a:n for a,n in counts.items() if n},
            provably_inferior_choices=sum(v>0 for v in losses),mean_first_action_loss_lower=float(sum(losses)/16)))
    return dict(variant='reflect',seeds=16,iterations=27000,searches=64,normal_identity_pairs=16,original_world_archive_identities=32,
        choices=groups,production_changed=False,
        scope='The highest certified Swords Dance loss in the archived 39-move family. Sixteen search seeds at this single '
              'decision; native default belief in both same-observation worlds, plus pinned true-roster oracle controls. '
              'All original-world rows reproduce the earlier archive exactly. Normal rows are identical across worlds. '
              'Losses use the independently certified Reflect-world first-action bounds with optimal later play, not '
              'sampled battle outcomes. Pinned results use unavailable roster knowledge and are not a deployable fix.')


def main():
    parser=argparse.ArgumentParser();parser.add_argument('--record',type=Path);args=parser.parse_args()
    family=json.loads(gzip.decompress((archive/'records.json.gz').read_bytes()))
    assert all(hashlib.sha256((root/p).read_bytes()).hexdigest()==h for p,h in family['hashes'].items())
    summary=json.loads((archive/'summary.json').read_bytes())
    assert max(summary['rows'],key=lambda r:r['normal_choice_loss_lower'])['move']=='reflect'
    case=next(r['case'] for r in family['result']['rows'] if r['case']['replacement']=='reflect')
    old=json.loads(gzip.decompress(old_path.read_bytes()))
    paths=['crates/bot/examples/hidden_move_witness.rs','tools/hidden-move-family-search',str((archive/'records.json.gz').relative_to(root)),str((archive/'summary.json').relative_to(root)),str(old_path.relative_to(root))]
    hashes={p:hashlib.sha256((root/p).read_bytes()).hexdigest() for p in paths}
    if args.record:
        assert not (archive/'reflect-search.json.gz').exists()
        out=json.loads(args.record.read_bytes());result=verify(out,case,summary,old)
        bundle=dict(result=out,hashes=hashes)
        (archive/'reflect-search.json.gz').write_bytes(gzip.compress(json.dumps(bundle,separators=(',',':')).encode(),mtime=0))
        (archive/'search-summary.json').write_text(json.dumps(result,indent=2)+'\n')
    bundle=json.loads(gzip.decompress((archive/'reflect-search.json.gz').read_bytes()))
    assert hashes==bundle['hashes']
    result=verify(bundle['result'],case,summary,old)
    assert result==json.loads((archive/'search-summary.json').read_bytes())
    for fault in ['missing_seed','choice','statistics']:
        bad=copy.deepcopy(bundle['result'])
        if fault=='missing_seed':bad['searches'].pop()
        elif fault=='choice':bad['searches'][1]['best']='move rockslide'
        else:bad['searches'][1]['visits'][0]+=1
        try:verify(bad,case,summary,old)
        except AssertionError:pass
        else:raise AssertionError(f'Accepted corruption: {fault}')
    print(json.dumps({k:v for k,v in result.items() if k!='scope'},indent=2))


if __name__=='__main__':main()
