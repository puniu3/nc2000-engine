#!/usr/bin/env python3
import datetime
import argparse
import gzip
import hashlib
import importlib.util
import json
import os
import pathlib
import subprocess

root = pathlib.Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser()
studies = parser.add_mutually_exclusive_group()
studies.add_argument("--frontier", action="store_true")
studies.add_argument("--witness", action="store_true")
studies.add_argument("--allocation", action="store_true")
studies.add_argument("--transfer", action="store_true")
studies.add_argument("--branches", action="store_true")
studies.add_argument("--direction", action="store_true")
studies.add_argument("--target-cut", action="store_true")
studies.add_argument("--descendant", action="store_true")
parser.add_argument("--verify-only", action="store_true")
args = parser.parse_args()
study = "policy-frontier-v1" if args.frontier else "policy-target-focus-v1"
targets = ["diagnostic", "pruned", "pruned-eager", "pruned-lazy", "refined"] if args.frontier else ["all_actions", "archived"]
if args.witness:
    study, targets = "policy-witness-v1", ["control", "side-0", "side-1", "side-1-merged", "side-1-refined"]
if args.allocation:
    study, targets = "policy-allocation-v1", ["control", "fair", "side-0-fair", "unrestricted-fair", "side-0-refined"]
if args.transfer:
    study, targets = "policy-transfer-v1", ["cold", "staged", "cold-total", "staged-lower", "staged-lower-refined", "cold-large", "staged-lower-fixed", "cold-fixed", "cold-extended"]
if args.branches:
    study, targets = "policy-branches-v1", ["small", "large", "interleaved"]
if args.direction:
    study, targets = "policy-direction-v1", ["control", "default-check", "directed"]
if args.target_cut:
    study, targets = "policy-target-cut-v1", ["control", "default-check", "targeted"]
if args.descendant:
    study, targets = "policy-descendant-v1", ["control", "default-check", "targeted"]
source = root / "findings" / study
spec = importlib.util.spec_from_file_location("policy_gap", root / "tools/policy-gap-report.py")
verifier = importlib.util.module_from_spec(spec)
spec.loader.exec_module(verifier)


def verify_projection(side, score, value):
    assert side in (0, 1)
    assert 0 <= score["lo"] <= score["hi"] <= 1
    expected = {"lo": score["lo"], "hi": 1.0} if side == 0 else {"lo": 0.0, "hi": 1 - score["lo"]}
    assert all(abs(value[key] - expected[key]) < 1e-12 for key in expected)


def verify(row):
    if row.get("schema") == "nc2000-fixed-policy-bound-v1":
        assert row["side"] in (0, 1) and row["priority_actions"]
        score = row["guaranteed_score"]
        value = row["unrestricted_game_value"]
        verify_projection(row["side"], score, value)
        graph = row["graph"]
        assert graph["initialized_nodes"] + graph["unexpanded_nodes"] == row["reference"]["nodes"]
        assert graph["unique_child_edges"] <= graph["resolved_edges"]
        if matrix := row.get("restricted_matrix"):
            assert len(matrix["actions"][row["side"]]) == 1
            expected_score = matrix["value"] if row["side"] == 0 else {
                "lo": 1 - matrix["value"]["hi"], "hi": 1 - matrix["value"]["lo"],
            }
            assert all(abs(score[key] - expected_score[key]) < 1e-12 for key in score)
            assert len(row["root_chance"]) == len(matrix["cells"])
            assert sum(cell["runs"] for cell in row["root_chance"]) == row["reference"]["runs"]
            assert sum(cell["visits"] for cell in row["root_chance"]) == sum(row["trial_depth_counts"])
            for cell, bounds in zip(row["root_chance"], matrix["cells"]):
                assert abs(cell["pending_mass"] + cell["child_uncertainty"] - (bounds["hi"] - bounds["lo"])) < 1e-9
                assert cell["expanded_children"] <= cell["unique_children"]
        return
    matrix = row["reference"]
    if "preparation" in row:
        preparation = row["preparation"]
        descendants = row.get("descendant_preparation", [])
        assert row["total_runs"] == matrix["runs"] + sum(p["runs"] for p in preparation) + sum(p["runs"] + p["enumeration_runs"] for p in descendants)
        assert abs(row["total_elapsed_ms"] - matrix["elapsed_ms"] - sum(p["elapsed_ms"] for p in preparation + descendants)) < 1e-6
        counts = [p["certificates"] for p in preparation + descendants]
        assert max(counts, default=0) <= matrix["imported_certificates"] <= sum(counts)
        assert 0 <= matrix["certificate_hits"] <= matrix["imported_certificates"]
        for prep in preparation:
            verify_projection(prep["side"], prep["guaranteed_score"], prep["unrestricted_game_value"])
        for prep in descendants:
            assert 0 < prep["mass"] <= 1 and prep["matching_leaves"] > 0
            assert 0 <= prep["value"]["lo"] <= prep["value"]["hi"] <= 1
            assert prep["matrix"]["value"] == prep["value"]
            assert sum(c["runs"] for c in prep["root_chance"]) == prep["runs"]
            assert len(prep["matrix"]["cells"]) == len(prep["matrix"]["actions"][0]) * len(prep["matrix"]["actions"][1])
    for endpoint in row["endpoints"]:
        for arm in ["archived", "uniform", "max_damage", "oracle"]:
            verifier.verify_assessment(matrix, endpoint["side"], endpoint[arm])
    if diagnostics := row.get("diagnostics"):
        directed = diagnostics.get("lower_directed_trials", 0) + diagnostics.get("upper_directed_trials", 0)
        assert directed in (0, diagnostics["trials"])
        assert 0 <= diagnostics.get("target_filtered_trials", 0) <= diagnostics["trials"]
        assert diagnostics.get("sufficient_reply_skips", 0) >= diagnostics.get("target_filtered_trials", 0)
        assert sum(diagnostics["trial_depth_counts"]) == diagnostics["trials"]
        assert len(diagnostics["root_chance"]) == len(matrix["cells"])
        for cell, bounds in zip(diagnostics["root_chance"], matrix["cells"]):
            assert abs(cell["pending_mass"] + cell["child_uncertainty"] - (bounds["hi"] - bounds["lo"])) < 1e-9
            if children := cell.get("largest_children"):
                assert len(children) == min(5, cell["unique_children"])
                assert len({c["key"] for c in children}) == len(children)
                assert abs(children[0]["uncertainty"] - cell["largest_child_uncertainty"]) < 1e-12
                assert all(a["uncertainty"] >= b["uncertainty"] for a, b in zip(children, children[1:]))
                for child in children:
                    width = child["bounds"]["hi"] - child["bounds"]["lo"]
                    assert abs(child["mass"] * width - child["uncertainty"]) < 1e-12
                    assert len(child["cells"]) == len(child["actions"][0]) * len(child["actions"][1])


if args.verify_only:
    records = json.loads(gzip.decompress((source / "records.json.gz").read_bytes()))
    assert set(records) == set(targets)
    for target in targets:
        verify(records[target]["result"])
    if args.branches:
        prior = json.loads(gzip.decompress((root / "findings/policy-transfer-v1/records.json.gz").read_bytes()))
        for target, previous in [("small", "cold"), ("large", "cold-fixed")]:
            current, old = records[target]["result"], prior[previous]["result"]
            for field in ["value", "cells", "actions", "runs", "nodes", "stop"]:
                assert current["reference"][field] == old["reference"][field], field
    if args.direction or args.target_cut or args.descendant:
        prior = json.loads(gzip.decompress((root / "findings/policy-branches-v1/records.json.gz").read_bytes()))
        assert records["control"] == prior["large"]
        for field in ["value", "cells", "actions", "runs", "nodes", "stop"]:
            assert records["default-check"]["result"]["reference"][field] == prior["small"]["result"]["reference"][field]
        if args.descendant:
            corpus = gzip.decompress((source / 'corpus.jsonl.gz').read_bytes())
            for name, record in records.items():
                manifest = record['manifest']
                protocol_bytes = (source / f'{name}.json').read_bytes()
                assert hashlib.sha256(protocol_bytes).hexdigest() == manifest['protocol_sha256']
                assert json.loads(protocol_bytes) == manifest['protocol']
                assert hashlib.sha256(corpus).hexdigest() == manifest['protocol']['corpus_sha256']
                baseline = (root / manifest['protocol']['baseline']).read_bytes()
                assert hashlib.sha256(baseline).hexdigest() == manifest['protocol']['baseline_sha256']
            row = records['targeted']['result']
            p = records['targeted']['manifest']['protocol']['descendant_preparation']
            assert row['state_key'] == p['root_state_key']
            assert len(row['descendant_preparation']) == 1
            prep = row['descendant_preparation'][0]
            assert prep['semantic_key'] == p['semantic_key']
            assert prep['actions'] == p['actions'] and prep['mass'] == p['mass']
            child = next(c for c in prior['large']['result']['diagnostics']['root_chance'][0]['largest_children']
                         if c['key'] == f"NoDamageBookkeeping({p['semantic_key']})")
            assert prep['mass'] == child['mass']
            assert max(prep['value']['lo'], child['bounds']['lo']) <= min(prep['value']['hi'], child['bounds']['hi'])
            assert row['reference']['certificate_hits'] > 0
            for cell, bounds in zip(prep['root_chance'], prep['matrix']['cells']):
                assert abs(cell['pending_mass'] + cell['child_uncertainty'] - (bounds['hi'] - bounds['lo'])) < 1e-9
        if args.direction:
            for name in ["default-check", "directed"]:
                diagnostic = records[name]["result"]["diagnostics"]
                assert (diagnostic["lower_directed_trials"] > 0) == (name == "directed")
                assert (diagnostic["upper_directed_trials"] > 0) == (name == "directed")
        if args.target_cut:
            assert records["default-check"]["result"]["diagnostics"]["sufficient_reply_skips"] == 0
    if args.transfer or args.branches or args.direction or args.target_cut or args.descendant:
        summary = json.loads((source / "summary.json").read_text())
        prior_path = root / summary["prior_certificate"]
        assert hashlib.sha256(prior_path.read_bytes()).hexdigest() == summary["prior_certificate_sha256"]
        prior = json.loads(prior_path.read_text())["combined"]["matrix"]
        matrices = [prior] + [record["result"]["reference"] for record in records.values()]
        combined = summary["combined"]["matrix"]
        assert all(matrix["actions"] == combined["actions"] for matrix in matrices)
        for index, cell in enumerate(combined["cells"]):
            assert cell == {"lo": max(m["cells"][index]["lo"] for m in matrices),
                            "hi": min(m["cells"][index]["hi"] for m in matrices)}
        rows, cols = map(len, combined["actions"])
        pure_lower = max(min(combined["cells"][r * cols + c]["lo"] for c in range(cols)) for r in range(rows))
        pure_upper = min(max(combined["cells"][r * cols + c]["hi"] for r in range(rows)) for c in range(cols))
        assert combined["value"] == {"lo": max(pure_lower, max(m["value"]["lo"] for m in matrices)),
                                     "hi": min(pure_upper, min(m["value"]["hi"] for m in matrices))}
        for side, assessment in enumerate(summary["combined"]["archived_first_decisions"]):
            verifier.verify_assessment(combined, side, assessment)
        if args.transfer:
            for small, large in [("cold", "cold-fixed"), ("staged-lower", "staged-lower-fixed"), ("cold-fixed", "cold-extended")]:
                before, after = (records[name]["result"] for name in (small, large))
                assert after["reference"]["value"]["lo"] >= before["reference"]["value"]["lo"]
                assert after["reference"]["value"]["hi"] <= before["reference"]["value"]["hi"]
                assert after["diagnostics"]["resource_closure_visits"] > 0
                assert after["diagnostics"]["first_resource_closure_nodes"] >= 90_000
                assert after["diagnostics"]["two_sided_invalidations"] == 0
    print(f"Verified {len(targets)} archived arms")
    raise SystemExit(0)

run = root / "tmp" / study / datetime.datetime.now().strftime("run-%Y%m%d-%H%M%S")
run.mkdir(parents=True)
corpus = gzip.decompress((source / "corpus.jsonl.gz").read_bytes())
(run / "corpus.jsonl").write_bytes(corpus)
environment = dict(os.environ, NC2000_REPO_ROOT=str(root))
subprocess.run(
    ["cargo", "build", "--release", "-p", "nc2000-bot", "--example", "endgame_policy_audit"],
    cwd=root, env=environment, check=True,
)
for target in targets:
    protocol = json.loads((source / f"{target}.json").read_text())
    assert hashlib.sha256(corpus).hexdigest() == protocol["corpus_sha256"]
    protocol["corpus"] = str((run / "corpus.jsonl").relative_to(root))
    path = run / f"{target}.json"
    path.write_text(json.dumps(protocol, indent=2) + "\n")
    subprocess.run(
        [str(root / "target/release/examples/endgame_policy_audit"), str(path), str(run / target)],
        cwd=root, env=environment, check=True,
    )
    row = json.loads((run / target / "game-019-d0017.json").read_text())
    verify(row)
    scores = {"guaranteed_score": row["guaranteed_score"]} if "guaranteed_score" in row else {
        "loss": [endpoint["archived"]["loss"] for endpoint in row["endpoints"]],
    }
    print(target, json.dumps({
        "stop": row["reference"]["stop"],
        "runs": row["reference"]["runs"],
        "total_runs": row.get("total_runs", row["reference"]["runs"]),
        **scores,
    }), flush=True)
print(f"Results: {run}")
