#!/usr/bin/env python3
import datetime
import argparse
import gzip
import hashlib
import importlib.util
import json
import os
import pathlib
import subprocess

root = pathlib.Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser()
studies = parser.add_mutually_exclusive_group()
studies.add_argument("--frontier", action="store_true")
studies.add_argument("--witness", action="store_true")
parser.add_argument("--verify-only", action="store_true")
args = parser.parse_args()
study = "policy-frontier-v1" if args.frontier else "policy-target-focus-v1"
targets = ["diagnostic", "pruned", "pruned-eager", "pruned-lazy", "refined"] if args.frontier else ["all_actions", "archived"]
if args.witness:
    study, targets = "policy-witness-v1", ["control", "side-0", "side-1", "side-1-merged", "side-1-refined"]
source = root / "findings" / study
spec = importlib.util.spec_from_file_location("policy_gap", root / "tools/policy-gap-report.py")
verifier = importlib.util.module_from_spec(spec)
spec.loader.exec_module(verifier)


def verify(row):
    if row.get("schema") == "nc2000-fixed-policy-bound-v1":
        assert row["side"] in (0, 1) and row["priority_actions"]
        score = row["guaranteed_score"]
        value = row["unrestricted_game_value"]
        assert 0 <= score["lo"] <= score["hi"] <= 1
        expected = {"lo": score["lo"], "hi": 1.0} if row["side"] == 0 else {"lo": 0.0, "hi": 1 - score["lo"]}
        assert all(abs(value[key] - expected[key]) < 1e-12 for key in expected)
        graph = row["graph"]
        assert graph["initialized_nodes"] + graph["unexpanded_nodes"] == row["reference"]["nodes"]
        assert graph["unique_child_edges"] <= graph["resolved_edges"]
        return
    matrix = row["reference"]
    for endpoint in row["endpoints"]:
        for arm in ["archived", "uniform", "max_damage", "oracle"]:
            verifier.verify_assessment(matrix, endpoint["side"], endpoint[arm])
    if diagnostics := row.get("diagnostics"):
        assert sum(diagnostics["trial_depth_counts"]) == diagnostics["trials"]
        assert len(diagnostics["root_chance"]) == len(matrix["cells"])
        for cell, bounds in zip(diagnostics["root_chance"], matrix["cells"]):
            assert abs(cell["pending_mass"] + cell["child_uncertainty"] - (bounds["hi"] - bounds["lo"])) < 1e-9


if args.verify_only:
    records = json.loads(gzip.decompress((source / "records.json.gz").read_bytes()))
    assert set(records) == set(targets)
    for target in targets:
        verify(records[target]["result"])
    print(f"Verified {len(targets)} archived arms")
    raise SystemExit(0)

run = root / "tmp" / study / datetime.datetime.now().strftime("run-%Y%m%d-%H%M%S")
run.mkdir(parents=True)
corpus = gzip.decompress((source / "corpus.jsonl.gz").read_bytes())
(run / "corpus.jsonl").write_bytes(corpus)
environment = dict(os.environ, NC2000_REPO_ROOT=str(root))
subprocess.run(
    ["cargo", "build", "--release", "-p", "nc2000-bot", "--example", "endgame_policy_audit"],
    cwd=root, env=environment, check=True,
)
for target in targets:
    protocol = json.loads((source / f"{target}.json").read_text())
    assert hashlib.sha256(corpus).hexdigest() == protocol["corpus_sha256"]
    protocol["corpus"] = str((run / "corpus.jsonl").relative_to(root))
    path = run / f"{target}.json"
    path.write_text(json.dumps(protocol, indent=2) + "\n")
    subprocess.run(
        [str(root / "target/release/examples/endgame_policy_audit"), str(path), str(run / target)],
        cwd=root, env=environment, check=True,
    )
    row = json.loads((run / target / "game-019-d0017.json").read_text())
    verify(row)
    scores = {"guaranteed_score": row["guaranteed_score"]} if "guaranteed_score" in row else {
        "loss": [endpoint["archived"]["loss"] for endpoint in row["endpoints"]],
    }
    print(target, json.dumps({
        "stop": row["reference"]["stop"],
        "runs": row["reference"]["runs"],
        **scores,
    }), flush=True)
print(f"Results: {run}")
