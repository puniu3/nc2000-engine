#!/usr/bin/env python3
import argparse
import hashlib
import json
import os
import pathlib
import subprocess

root = pathlib.Path(__file__).resolve().parents[1]
destination = root / 'findings/adaptive-agent-smoke-v1'


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def check(rows):
    mixed = 'blind:1000:0.4:16:mix'
    assert rows['null']['agent_a'] == rows['null']['agent_b'] == mixed
    assert rows['comparison']['agent_a'] == mixed
    assert rows['comparison']['agent_b'] == 'blind:1000:0.4:16'
    for row in rows.values():
        assert row['result']['games'] == 4 and row['result']['invalid_games'] == 0
        assert row['config']['requested_games'] == 4
        assert row['config']['base_seed'] == 2026111501
    assert rows['null']['result']['pair_scores'] == [0.5, 0.5]
    assert rows['null']['result']['split_pairs'] == 0
    return dict(games=8, invalid_games=0, identical_agent_pair_scores=rows['null']['result']['pair_scores'],
                comparison_pair_scores=rows['comparison']['result']['pair_scores'],
                scope='End-to-end native arena smoke only: four identical mixed-agent games and four mixed-vs-default games at 1000 iterations on meta-pool-v0 teams 0-3. Separate positive unit coverage exercises actual mixing at 27000 iterations. These small smoke samples and the older pool do not establish strength improvement.')


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--verify-only', action='store_true')
    args = parser.parse_args()
    env = {**os.environ, 'NC2000_REPO_ROOT': str(root)}
    binary = root / 'target/release/examples/arena'
    if not args.verify_only:
        assert not destination.exists()
        subprocess.run(['cargo', 'build', '--release', '-p', 'nc2000-bot', '--example', 'arena'], cwd=root, env=env, check=True)
        destination.mkdir()
        sources = ['crates/bot/src/blind.rs', 'crates/bot/src/root_policy.rs', 'crates/bot/examples/arena.rs',
                   'crates/bot/tests/blind.rs', 'crates/bot/tests/root_mix_probes.rs']
        (destination / 'manifest.json').write_text(json.dumps(dict(binary_sha256=sha(binary),
            source_sha256={p:sha(root/p) for p in sources}), indent=2) + '\n')
        for label, opponent in [('null', 'blind:1000:0.4:mix'), ('comparison', 'blind:1000:0.4')]:
            command = [str(binary), 'blind:1000:0.4:mix', opponent, '--games', '4', '--seed', '2026111501',
                       '--threads', '4', '--pool', 'meta:0-3', '--crn-seeds', '--jsonl', str(destination / f'{label}.jsonl')]
            with (destination / f'{label}.log').open('w') as log:
                subprocess.run(command, cwd=root, env=env, stdout=log, stderr=subprocess.STDOUT, check=True)
    rows = {}
    for label in ['null', 'comparison']:
        path = destination / f'{label}.jsonl'
        lines = path.read_text().splitlines()
        assert len(lines) == 1
        rows[label] = json.loads(lines[0])
        subprocess.run([str(binary), '--validate-jsonl', str(path)], cwd=root, env=env, check=True)
    summary = check(rows)
    path = destination / 'summary.json'
    if args.verify_only:
        assert summary == json.loads(path.read_text())
        print('adaptive-agent-smoke: verified 8 games and identical-agent null control')
    else:
        path.write_text(json.dumps(summary, indent=2) + '\n')
        print(json.dumps(summary, indent=2))


if __name__ == '__main__':
    main()
