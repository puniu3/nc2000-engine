#!/usr/bin/env python3
import argparse
import gzip
import hashlib
import json
import math
import pathlib
import runpy

root = pathlib.Path(__file__).resolve().parents[1]
archive = root / 'findings/small-gain-probe-v1'


def read(label):
    raw = (archive / label / 'records.json.gz').read_bytes()
    return json.loads(gzip.decompress(raw))['record'], hashlib.sha256(raw).hexdigest()


def summarize():
    warm, warm_sha = read('518400-probes0')
    final, final_sha = read('864000')
    for key in ['state_key', 'actions', 'search_seed_base', 'search_seeds', 'family']:
        assert warm[key] == final[key]
    changed = [p for p, h in warm['source_hashes'] if dict(final['source_hashes'])[p] != h]
    assert changed == ['crates/bot/src/root_policy.rs']
    assert warm['iterations'] + final['probe_iterations'] == final['iterations']
    a = next(r for r in warm['rows'] if r['mode'] == 'pinned' and r['side'] == 1)
    b = next(r for r in final['rows'] if r['mode'] == 'pinned' and r['side'] == 1)
    assert a['seed'] == b['seed'] and a['probes_used'] == 0
    assert b['probes_used'] == final['probe_iterations']
    assert [y-x for x, y in zip(a['visits'], b['visits'])] == b['joint_probe_visits']
    before = {(c['own'], c['reply']): c for c in a['joint']}
    rows = []
    for c in sorted(b['joint'], key=lambda c: (c['own'], c['reply'])):
        old = before.get((c['own'], c['reply']), dict(samples=0, mean=0))
        n = c['samples'] - old['samples']
        assert n >= 0
        mean = (c['samples']*c['mean']-old['samples']*old['mean'])/n if n else None
        if n == 0:
            assert c['mean'] == old['mean']
        reply = final['actions'][0].index(c['reply'])
        lo, hi = final['proof']['cells'][reply*len(final['actions'][1])+c['own']]
        optimal = [1-hi, 1-lo]
        rows.append(dict(own=final['actions'][1][c['own']], reply=c['reply'],
                         warm_samples=old['samples'], added_samples=n, final_samples=c['samples'],
                         warm_mean=old['mean'] if old['samples'] else None,
                         added_mean=mean, final_mean=c['mean'], optimal_continuation=optimal,
                         final_bias=[c['mean']-optimal[1], c['mean']-optimal[0]],
                         heuristic_radius=math.sqrt(math.log(200*6)/(2*c['samples']))))
    assert sum(r['added_samples'] for r in rows) == b['probes_used']
    stale = next(r for r in rows if r['own'] == 'move destinybond' and r['reply'] == 'move curse')
    assert stale['added_samples'] == 0 and stale['final_bias'][1] < -.025
    return dict(inputs={'518400-probes0': warm_sha, '864000': final_sha},
                changed_sources=changed, state_key=final['state_key'], side=1, rows=rows,
                scope='A deterministic replay of the ordinary warm prefix, with unchanged search sources; '
                      'only the final root selector and its tests differ. Cumulative least-count probing '
                      'never revisits Destiny Bond versus Curse. Its continuation estimate remains biased '
                      'despite the added probe budget. This does not measure what new samples of that cell '
                      'would return, or certify sampled continuation policies.')


def summarize_fresh():
    warm, warm_sha = read('518400-probes0')
    fresh, fresh_sha = read('864000-fresh')
    baseline = summarize()
    assert fresh['fresh_probes'] and not fresh['adaptive_probes']
    for key in ['state_key', 'actions', 'search_seed_base', 'search_seeds', 'family']:
        assert warm[key] == fresh[key]
    changed = [p for p, h in warm['source_hashes'] if dict(fresh['source_hashes'])[p] != h]
    assert changed == ['crates/bot/examples/counter_mix_probe.rs']
    rows = []
    for r in fresh['rows']:
        if r['mode'] != 'pinned':
            continue
        a = next(a for a in warm['rows'] if a['mode'] == 'pinned' and a['side'] == r['side'])
        evidence = r['fresh_evidence']
        assert evidence['warm_joint'] == a['joint']
        assert evidence['warm_visits'] == a['visits']
        if r['side'] != 1:
            continue
        for c in evidence['phase_types'][0]['cells']:
            own = fresh['actions'][1][c['own']]
            reply = fresh['actions'][0][c['reply']]
            old = next(v for v in baseline['rows'] if v['own'] == own and v['reply'] == reply)
            final = next(v for v in r['joint'] if v['own'] == c['own'] and v['reply'] == reply)
            lo, hi = fresh['proof']['cells'][c['reply']*len(fresh['actions'][1])+c['own']]
            optimal = [1-hi, 1-lo]
            assert c['samples'] == 57600
            rows.append(dict(own=own, reply=reply, fresh_samples=c['samples'],
                             stale_mean=old['final_mean'], cumulative_mean=final['mean'],
                             fresh_mean=c['mean'], optimal_continuation=optimal,
                             fresh_bias=[c['mean']-optimal[1], c['mean']-optimal[0]]))
    return dict(inputs={'518400-probes0':warm_sha,'864000-fresh':fresh_sha,
                        '864000':baseline['inputs']['864000']}, changed_sources=changed,
                verified_warm_sides=2, rows=rows,
                scope='One known-type fixture and one search seed. Both warm prefixes match exactly. '
                      'The fresh phase forces every eligible action pair equally, regardless of the '
                      'adaptive gate. Fresh means still reflect changing search continuations and '
                      'are not certified game values. This isolates probe history within this fixture; '
                      'it is not a general strength comparison or a production selection rule.')


def summarize_hp():
    coarse, coarse_sha = read('864000-fresh')
    exact, exact_sha = read('864000-fresh-hp0')
    summarize_run = runpy.run_path(str(root/'tools/small-gain-probe'))['summarize']
    for key in ['state_key', 'actions', 'search_seed_base', 'search_seeds', 'family',
                'iterations', 'probe_iterations', 'fresh_probes']:
        assert coarse[key] == exact[key]
    assert coarse.get('hp_buckets',16) == 16 and exact['hp_buckets'] == 0
    changed = [p for p, h in coarse['source_hashes'] if dict(exact['source_hashes'])[p] != h]
    assert changed == ['crates/bot/examples/counter_mix_probe.rs']
    rows = []
    for name, record in [('bucketed',coarse),('exact_hp',exact)]:
        summary = summarize_run(record)
        for r in record['rows']:
            if r['mode'] != 'pinned':
                continue
            own = record['actions'][1].index('move destinybond') if r['side'] == 1 else record['actions'][0].index('move curse')
            reply = record['actions'][0].index('move curse') if r['side'] == 1 else record['actions'][1].index('move destinybond')
            cell = next(c for c in r['fresh_evidence']['phase_types'][0]['cells'] if c['own']==own and c['reply']==reply)
            columns = len(record['actions'][1])
            lo, hi = record['proof']['cells'][reply*columns+own if r['side']==1 else own*columns+reply]
            if r['side'] == 1:
                lo, hi = 1-hi, 1-lo
            rows.append(dict(variant=name, side=r['side'], samples=cell['samples'],
                             fresh_mean=cell['mean'], optimal_continuation=[lo,hi],
                             fresh_bias=[cell['mean']-hi,cell['mean']-lo],
                             policy_results=summary['rows'][r['side']]))
    return dict(inputs={'864000-fresh':coarse_sha,'864000-fresh-hp0':exact_sha},
                changed_sources=changed, rows=rows,
                scope='One seed and one known-type fixture at equal iteration and probe budgets. '
                      'HP bucketing is disabled throughout warm search and forced fresh probes. '
                      'Different state keys can change random-number consumption and tree allocation; '
                      'this is not a matched-trajectory comparison, a general convergence proof, or a '
                      'comparison at matched thinking time.')


def summarize_trace():
    control, control_sha = read('864000-fresh')
    traced, trace_sha = read('864000-fresh-trace')
    assert traced['trace_probes']
    for key in ['state_key','actions','search_seed_base','search_seeds','iterations','probe_iterations']:
        assert control[key] == traced[key]
    changed = [p for p,h in control['source_hashes'] if dict(traced['source_hashes'])[p] != h]
    assert changed == ['crates/bot/examples/counter_mix_probe.rs','crates/bot/src/blind.rs']
    rows = []
    assert len(control['rows']) == len(traced['rows'])
    for a,b in zip(control['rows'],traced['rows']):
        stripped = dict(b)
        if b['mode'] == 'pinned':
            stripped['fresh_evidence'] = {k:v for k,v in b['fresh_evidence'].items() if k != 'probe_trace'}
        assert a == stripped
        if b['mode'] != 'pinned':
            continue
        evidence = b['fresh_evidence']
        phase = evidence['phase_types'][0]
        side = b['side']
        for cell in phase['cells']:
            stats = evidence['probe_trace'][cell['own']*phase['replies']+cell['reply']]
            n = cell['samples']
            assert stats['samples'] == n
            terminal = stats['terminal']
            weight = stats['terminal_reward']
            assert 0 <= terminal <= n and 0 <= weight <= terminal
            assert 0 <= stats['expanded_leaf']+stats['capped_leaf'] <= n
            missing = n-terminal
            unobserved_reward = cell['mean']*n-weight
            assert -1e-7 <= unobserved_reward <= missing+1e-7
            own,reply = cell['own'],cell['reply']
            n1 = len(traced['actions'][1])
            lo,hi = traced['proof']['cells'][own*n1+reply if side==0 else reply*n1+own]
            if side==1:
                lo,hi = 1-hi,1-lo
            envelope = [weight/n,(weight+missing)/n]
            rollout_envelope = [max(0,envelope[0]-stats['expanded_leaf']/n),
                                min(1,envelope[1]+stats['expanded_leaf']/n)]
            rows.append(dict(side=side,own=traced['actions'][side][own],
                             reply=traced['actions'][1-side][reply],trace=stats,
                             mean=cell['mean'],optimal_continuation=[lo,hi],
                             arbitrary_nonterminal_values=envelope,
                             arbitrary_nonterminal_and_rollout_values=rollout_envelope,
                             residual_bias=[envelope[0]-hi,envelope[1]-lo],
                             cutoff_and_rollout_values_cannot_remove_sample_bias=rollout_envelope[1]<lo or rollout_envelope[0]>hi,
                             cutoff_values_cannot_remove_sample_bias=envelope[1]<lo or envelope[0]>hi))
    return dict(inputs={'864000-fresh':control_sha,'864000-fresh-trace':trace_sha},
                changed_sources=changed,rows=rows,
                scope='The instrumented run reproduces all uninstrumented search statistics and '
                      'policies exactly. The envelope allows every nonterminal sample any reward in '
                      '[0,1], holding observed terminal outcomes fixed. A wider envelope also allows '
                      'any newly expanded rollout return to change by up to one. This isolates how much cutoff '
                      'evaluation could change these recorded sample means. It is not a confidence '
                      'interval for expected returns or a certificate for continuation policies.')


def summarize_floor_counterexample():
    label = '864000-seed13722711268216851060'
    record, digest = read(label)
    warm, _ = read('518400-probes0')
    assert dict(record['source_hashes'])['crates/bot/src/root_policy.rs'] == dict(warm['source_hashes'])['crates/bot/src/root_policy.rs']
    assert record['typed_probes'] and record['adaptive_probes'] and not record.get('fresh_probes',False)
    report = runpy.run_path(str(root/'tools/small-gain-probe'))['summarize'](record)
    side = report['rows'][1]
    assert side['side'] == 1 and side['mixed'] and side['margin'] > .02
    assert side['probed'] == record['probe_iterations']
    gap = [side['loss'][0]-side['fallback_loss'][1],side['loss'][1]-side['fallback_loss'][0]]
    assert gap[0] > .0235
    return dict(input={label:digest},threshold=.02,seed=record['search_seed_base'],
                policy=side['policy'],search_margin=side['margin'],certified_loss=side['loss'],
                fallback_loss=side['fallback_loss'],certified_excess_loss=gap,
                scope='The cumulative type-conditioned adaptive probing path accepts a mixture at '
                      'the restored 0.02 threshold. Its certified first-action loss exceeds the pure '
                      'fallback loss by more than 0.0235. This is a counterexample to treating that '
                      'threshold as a game-value guarantee; raising a fixed threshold is not a repair. '
                      'The default ordinary agent does not use this experimental selector.')


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--verify-only', action='store_true')
    parser.add_argument('--fresh', action='store_true')
    parser.add_argument('--hp-ablation', action='store_true')
    parser.add_argument('--trace', action='store_true')
    parser.add_argument('--floor-counterexample', action='store_true')
    args = parser.parse_args()
    modes = [(args.fresh,summarize_fresh,'fresh-history.json'),
             (args.hp_ablation,summarize_hp,'hp-ablation.json'),
             (args.trace,summarize_trace,'trace.json'),
             (args.floor_counterexample,summarize_floor_counterexample,'floor-counterexample.json')]
    selected = [(fn,name) for enabled,fn,name in modes if enabled]
    assert len(selected) <= 1
    fn,name = selected[0] if selected else (summarize,'history.json')
    report = fn()
    path = archive / name
    if args.verify_only:
        assert json.loads(path.read_text()) == report
        print('probe-history: verified source identity, warm replay, probe increments and certified bias')
    else:
        path.write_text(json.dumps(report, indent=2)+'\n')
        print(json.dumps(report, indent=2))


if __name__ == '__main__':
    main()
