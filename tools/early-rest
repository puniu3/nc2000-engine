#!/usr/bin/env python3
import datetime
import hashlib
import json
import pathlib
import subprocess

root = pathlib.Path(__file__).resolve().parents[1]
run = root / 'tmp/early-rest-v1' / datetime.datetime.now().strftime('run-%Y%m%d-%H%M%S')
report = run / 'report'
report.mkdir(parents=True)
for name in ['protocol.json', 'analysis-plan.json', 'perish-guard-equivalence.json']:
    (report / name).write_bytes((root / 'findings/early-rest-v1' / name).read_bytes())


def execute(args, output=None):
    if output:
        with (run / output).open('w') as f:
            subprocess.run(args, cwd=root, stdout=f, check=True)
    else:
        subprocess.run(args, cwd=root, check=True)


execute(['cargo', 'build', '--release', '-p', 'nc2000-bot', '--example', 'early_rest_duel', '--example', 'next_move_support'])
sources = ['crates/bot/src/belief.rs', 'crates/bot/examples/early_rest_duel.rs']
(run / 'pilot-source-sha256.json').write_text(json.dumps({p: hashlib.sha256((root / p).read_bytes()).hexdigest() for p in sources}, indent=2) + '\n')
execute(['target/release/examples/early_rest_duel', str(report / 'protocol.json'), str(run / 'pilot')])
execute(['target/release/examples/early_rest_duel', str(report / 'protocol.json'), str(run / 'pilot'), '--verify'], 'pilot-verification.json')
execute(['target/release/examples/early_rest_duel', str(report / 'protocol.json'), str(run / 'pilot'), '--audit'], 'first-divergence.json')
execute(['target/release/examples/next_move_support', 'findings/early-rest-v1/corpus-protocol.json', str(run / 'corpus')])
execute(['python3', 'tools/early-rest-report.py', str(run), str(report)])
execute(['python3', 'tools/early-rest-render.py', str(report)])
print('Report:', report)
