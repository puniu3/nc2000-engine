diff --git a/crates/engine/examples/attract_gender_audit.rs b/crates/engine/examples/attract_gender_audit.rs
new file mode 100644
index 0000000..f143dd0
--- /dev/null
+++ b/crates/engine/examples/attract_gender_audit.rs
@@ -0,0 +1,219 @@
+//! Isolate gender in actual Attract turns, then validate legal catalog changes.
+//! cargo run -p nc2000-engine --example attract_gender_audit -- OLD_POOL NEW_POOL NEW_REPORT
+use nc2000_engine::{
+    battle::{
+        enumerate::enumerate_step,
+        moveexec::{get_damage_synthetic, synthetic_move},
+        PokemonSet, SearchChoice,
+    },
+    dex::{toid, Dex},
+    state::{Battle, Gender},
+    validate::{validate_team, Learnsets},
+};
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use std::{fs, io::Write, path::Path};
+
+fn battle(dex: &Dex, sets: &Value, lead: usize) -> Battle {
+    let team: Vec<PokemonSet> = serde_json::from_value(sets.clone()).unwrap();
+    let mut selection = None;
+    for i in 0..team.len() {
+        for j in i + 1..team.len() {
+            if i != lead
+                && j != lead
+                && u16::from(team[lead].level) + u16::from(team[i].level) + u16::from(team[j].level)
+                    <= 155
+            {
+                selection.get_or_insert((i, j));
+            }
+        }
+    }
+    let (i, j) = selection.unwrap();
+    let mut b = Battle::from_fixture(dex, "1,2,3,4", &team, &team).unwrap();
+    for side in 0..2 {
+        b.choose(dex, side, &format!("team {},{},{}", lead + 1, i + 1, j + 1))
+            .unwrap();
+    }
+    b.set_log_enabled(false);
+    b
+}
+fn damage(dex: &Dex, b: &mut Battle, name: &str, atk: i8, def: i8) -> i64 {
+    let id = b.active_id(0).unwrap();
+    b.poke_mut(id).boosts[0] = atk;
+    b.poke_mut(id).boosts[1] = def;
+    let mut fake = synthetic_move(dex, 40);
+    fake.base_move_type = dex
+        .move_static(dex.moves.id(&toid(name)).unwrap())
+        .move_type;
+    get_damage_synthetic(b, dex, id, id, fake).unwrap() as i64
+}
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    assert_eq!(
+        args.len(),
+        4,
+        "usage: attract_gender_audit OLD_POOL NEW_POOL NEW_REPORT"
+    );
+    let root = Path::new(env!("CARGO_MANIFEST_DIR")).join("../..");
+    let dex_text = fs::read_to_string(root.join("data/gen2stadium2.json")).unwrap();
+    let dex = Dex::from_json(&dex_text).unwrap();
+    let ls =
+        Learnsets::from_json(&fs::read_to_string(root.join("data/learnsets-gen2.json")).unwrap())
+            .unwrap();
+    let old_bytes = fs::read(root.join(&args[1])).unwrap();
+    let new_bytes = fs::read(root.join(&args[2])).unwrap();
+    let old: Value = serde_json::from_slice(&old_bytes).unwrap();
+    let new: Value = serde_json::from_slice(&new_bytes).unwrap();
+    // Controlled causal intervention: the identical battle has only gender
+    // changed. Synthetic genderless Venusaur/Ninetales are negative controls,
+    // not proposed legal sets. The actual proposed sets are validated below.
+    let mon = |sp: &str, mv: &str| {
+        serde_json::from_value::<PokemonSet>(json!({
+            "name":sp,"species":sp,"moves":[mv],"level":50,
+            "ivs":{"hp":30,"atk":30,"def":30,"spa":30,"spd":30,"spe":30},
+            "evs":{"hp":255,"atk":255,"def":255,"spa":255,"spd":255,"spe":255}
+        }))
+        .unwrap()
+    };
+    let own = vec![
+        mon("Ninetales", "Attract"),
+        mon("Snorlax", "Rest"),
+        mon("Starmie", "Recover"),
+    ];
+    let foe = vec![
+        mon("Venusaur", "Growth"),
+        mon("Snorlax", "Rest"),
+        mon("Starmie", "Recover"),
+    ];
+    let mut base = Battle::from_fixture(&dex, "1,2,3,4", &own, &foe).unwrap();
+    for side in 0..2 {
+        base.choose(&dex, side, "team 1,2,3").unwrap();
+    }
+    base.set_log_enabled(false);
+    let mut matrix = Vec::new();
+    for source_gender in [Gender::M, Gender::F, Gender::N] {
+        for target_gender in [Gender::M, Gender::F, Gender::N] {
+            let mut b = base.clone();
+            let src = b.active_id(0).unwrap();
+            let dst = b.active_id(1).unwrap();
+            b.poke_mut(src).gender = source_gender;
+            b.poke_mut(dst).gender = target_gender;
+            let choices = [
+                Some(SearchChoice::Move(dex.moves.id("attract").unwrap())),
+                Some(SearchChoice::Move(dex.moves.id("growth").unwrap())),
+            ];
+            let step = enumerate_step(&dex, &b, choices, 20000).unwrap();
+            let mut infatuated = 0.0;
+            let mut acted = 0.0;
+            let mut mass = 0.0;
+            for leaf in &step.leaves {
+                mass += leaf.prob;
+                let target = leaf.battle.poke(dst);
+                if target.has_volatile(dex.conds_id("attract").unwrap()) {
+                    infatuated += leaf.prob;
+                }
+                if target.boosts[2] > 0 {
+                    acted += leaf.prob;
+                }
+            }
+            let opposite = matches!(
+                (source_gender, target_gender),
+                (Gender::M, Gender::F) | (Gender::F, Gender::M)
+            );
+            assert!((mass - 1.0).abs() < 1e-10);
+            assert!((infatuated - if opposite { 1.0 } else { 0.0 }).abs() < 1e-10);
+            assert!((acted - if opposite { 0.5 } else { 1.0 }).abs() < 1e-10);
+            let label = |g: Gender| if g == Gender::N { "N" } else { g.as_str() };
+            matrix.push(json!({"sourceGender":label(source_gender),"targetGender":label(target_gender),
+                "infatuatedProbability":infatuated,"targetActsProbability":acted,"leaves":step.leaves.len()}));
+        }
+    }
+    let mut rows = Vec::new();
+    let mut checks = 0;
+    assert_eq!(
+        old["teams"].as_array().unwrap().len(),
+        new["teams"].as_array().unwrap().len()
+    );
+    for (before, after) in old["teams"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .zip(new["teams"].as_array().unwrap())
+    {
+        assert_eq!(before["id"], after["id"]);
+        assert_eq!(before["drawWeight"], after["drawWeight"]);
+        for sets in [&before["sets"], &after["sets"]] {
+            let verdict = validate_team(&dex, &ls, &sets.to_string());
+            assert_eq!(verdict["ok"], true, "{verdict}");
+            assert!(!verdict["findings"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .any(|f| matches!(f["code"].as_str(), Some("dv-gender" | "gender-species"))));
+        }
+        for (slot, (a, z)) in before["sets"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .zip(after["sets"].as_array().unwrap())
+            .enumerate()
+        {
+            if a == z {
+                continue;
+            }
+            assert_eq!(a["gender"], "M");
+            assert_eq!(z["gender"], "F");
+            let mut restored = z.clone();
+            restored["gender"] = a["gender"].clone();
+            restored["ivs"]["atk"] = a["ivs"]["atk"].clone();
+            assert_eq!(restored, *a, "unexpected non-gender/Attack-IV change");
+            let mut b = battle(&dex, &before["sets"], slot);
+            let mut n = battle(&dex, &after["sets"], slot);
+            let bp = b.poke(b.active_id(0).unwrap());
+            let np = n.poke(n.active_id(0).unwrap());
+            assert_eq!(bp.gender, Gender::M);
+            assert_eq!(np.gender, Gender::F);
+            assert_eq!(bp.maxhp, np.maxhp);
+            assert_eq!(bp.stored_stats[1..], np.stored_stats[1..]);
+            assert!(np.stored_stats[0] <= bp.stored_stats[0]);
+            let (attack_before, attack_after, hp) =
+                (bp.stored_stats[0], np.stored_stats[0], bp.maxhp);
+            let mut damages = Vec::new();
+            for mv in a["moves"].as_array().unwrap() {
+                let name = mv.as_str().unwrap();
+                damages.push(json!({"move":name,"neutralBefore":damage(&dex,&mut b,name,0,0),
+                    "neutralAfter":damage(&dex,&mut n,name,0,0),"swaggerBefore":damage(&dex,&mut b,name,2,0),
+                    "swaggerAfter":damage(&dex,&mut n,name,2,0)}));
+                for atk in -6..=6 {
+                    for def in -6..=6 {
+                        assert!(
+                            damage(&dex, &mut n, name, atk, def)
+                                <= damage(&dex, &mut b, name, atk, def)
+                        );
+                        checks += 1;
+                    }
+                }
+            }
+            rows.push(json!({"baseId":before["id"],"slot":slot+1,"species":a["species"],"hp":hp,
+                "genderBefore":"M","genderAfter":"F","attackDvBefore":a["ivs"]["atk"].as_i64().unwrap()/2,
+                "attackDvAfter":z["ivs"]["atk"].as_i64().unwrap()/2,
+                "attackBefore":attack_before,"attackAfter":attack_after,"damage":damages}));
+        }
+    }
+    let report = json!({"format":"nc2000-attract-gender-mechanics-v1",
+        "baselineSha256":format!("{:x}",Sha256::digest(&old_bytes)),"optimizedSha256":format!("{:x}",Sha256::digest(&new_bytes)),
+        "matrixControl":"Identical stats, moves, items, seed and field; gender intervention only. Genderless Ninetales/Venusaur are synthetic negative controls, not legal catalog proposals.",
+        "matrix":matrix,"validatedTeams":new["teams"].as_array().unwrap().len(),"changedSets":rows.len(),
+        "selfHitComparisons":checks,"selfHitIncreases":0,"unchanged":"HP, non-Attack stats, moves, items, EVs, levels, team IDs, draw weights",
+        "rows":rows});
+    let out = root.join(&args[3]);
+    fs::create_dir_all(out.parent().unwrap()).unwrap();
+    fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(out)
+        .unwrap()
+        .write_all((serde_json::to_string_pretty(&report).unwrap() + "\n").as_bytes())
+        .unwrap();
+    println!("9 exact Attract cases; {} teams validated; {} legal gender changes; {} self-hit comparisons",new["teams"].as_array().unwrap().len(),rows.len(),checks);
+}
diff --git a/crates/engine/examples/low_attack_catalog_audit.rs b/crates/engine/examples/low_attack_catalog_audit.rs
new file mode 100644
index 0000000..0c3a8b8
--- /dev/null
+++ b/crates/engine/examples/low_attack_catalog_audit.rs
@@ -0,0 +1,257 @@
+//! Offline proposal; never rewrites the shipped catalog, inventory or prior.
+//! cargo run -p nc2000-engine --example low_attack_catalog_audit --
+//!   data/team-pool-v2/team-pool.json NEW_OUTPUT_DIRECTORY
+use nc2000_engine::{
+    battle::{
+        moveexec::{get_damage_synthetic, synthetic_move},
+        PokemonSet,
+    },
+    dex::{toid, Dex},
+    state::Battle,
+    validate::{validate_team, Learnsets},
+};
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use std::{collections::BTreeMap, fs, path::Path};
+
+fn sha(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+fn iv(set: &Value, key: &str) -> i64 {
+    set["ivs"][key].as_i64().unwrap_or(31) & 30
+}
+fn shiny(set: &Value, atk: i64) -> bool {
+    ["def", "spe", "spa"].iter().all(|k| iv(set, k) / 2 == 10) && atk % 4 >= 2
+}
+fn gender(species: &Value, atk: i64) -> String {
+    species["gender"]
+        .as_str()
+        .map(str::to_owned)
+        .unwrap_or_else(|| {
+            let female = species["genderRatio"]["F"].as_f64().unwrap_or(0.5);
+            if (atk as f64) < female * 16.0 {
+                "F"
+            } else {
+                "M"
+            }
+            .to_owned()
+        })
+}
+fn battle(dex: &Dex, sets: &Value, lead: usize) -> Battle {
+    let team: Vec<PokemonSet> = serde_json::from_value(sets.clone()).unwrap();
+    let pair = (0..team.len())
+        .filter(|&i| i != lead)
+        .flat_map(|i| {
+            let team = &team;
+            (i + 1..team.len())
+                .filter(move |&j| {
+                    j != lead
+                        && u16::from(team[lead].level)
+                            + u16::from(team[i].level)
+                            + u16::from(team[j].level)
+                            <= 155
+                })
+                .map(move |j| (i, j))
+        })
+        .next()
+        .expect("legal lead selection");
+    let mut b = Battle::from_fixture(dex, "1,2,3,4", &team, &team).unwrap();
+    let choice = format!("team {},{},{}", lead + 1, pair.0 + 1, pair.1 + 1);
+    b.choose(dex, 0, &choice).unwrap();
+    b.choose(dex, 1, &choice).unwrap();
+    b.set_log_enabled(false);
+    b
+}
+fn self_hit(dex: &Dex, b: &mut Battle, move_name: &str, atk: i8, def: i8) -> i64 {
+    let p = b.active_id(0).unwrap();
+    b.poke_mut(p).boosts[0] = atk;
+    b.poke_mut(p).boosts[1] = def;
+    let id = dex.moves.id(&toid(move_name)).unwrap();
+    let mut fake = synthetic_move(dex, 40);
+    // Same item/base-type handling as conditions.rs's confusion handler.
+    fake.base_move_type = dex.move_static(id).move_type;
+    get_damage_synthetic(b, dex, p, p, fake).unwrap() as i64
+}
+fn write(dir: &Path, name: &str, value: &Value) {
+    fs::write(
+        dir.join(name),
+        serde_json::to_string_pretty(value).unwrap() + "\n",
+    )
+    .unwrap();
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    assert_eq!(
+        args.len(),
+        3,
+        "usage: low_attack_catalog_audit INPUT_POOL NEW_OUTPUT_DIRECTORY"
+    );
+    let root = Path::new(env!("CARGO_MANIFEST_DIR")).join("../..");
+    let input_path = root.join(&args[1]);
+    let output = root.join(&args[2]);
+    assert!(
+        !output.exists(),
+        "output must be a new directory; existing work is never overwritten"
+    );
+    let input = fs::read(&input_path).unwrap();
+    let pool: Value = serde_json::from_slice(&input).unwrap();
+    let dex_bytes = fs::read(root.join("data/gen2stadium2.json")).unwrap();
+    let dex_json: Value = serde_json::from_slice(&dex_bytes).unwrap();
+    let dex = Dex::from_json(std::str::from_utf8(&dex_bytes).unwrap()).unwrap();
+    let ls =
+        Learnsets::from_json(&fs::read_to_string(root.join("data/learnsets-gen2.json")).unwrap())
+            .unwrap();
+    let mut teams = pool["teams"].as_array().unwrap().clone();
+    let mut rows = Vec::new();
+    let mut excluded = BTreeMap::<String, usize>::new();
+    let mut changed_teams = 0;
+    let mut comparisons = 0;
+    let mut already_low_dv = 0;
+    for team in &mut teams {
+        let original = team["sets"].clone();
+        let check = validate_team(&dex, &ls, &original.to_string());
+        assert_eq!(check["ok"], true, "source {}: {check}", team["id"]);
+        let base_id = team["id"].as_str().unwrap().to_owned();
+        let mut changed = false;
+        for (slot, set) in original.as_array().unwrap().iter().enumerate() {
+            let moves: Vec<&str> = set["moves"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .map(|m| m.as_str().unwrap())
+                .collect();
+            let ids: Vec<String> = moves.iter().map(|m| toid(m)).collect();
+            let reason = if ids.iter().any(|m| m.starts_with("hiddenpower")) {
+                Some("hidden-power")
+            } else if ids.iter().any(|m| dex_json["moves"][m].is_null()) {
+                panic!("unknown move in {base_id}")
+            } else if ids
+                .iter()
+                .any(|m| dex_json["moves"][m]["category"] == "Physical")
+            {
+                Some("physical-move")
+            } else if ids.iter().any(|m| {
+                matches!(
+                    m.as_str(),
+                    "metronome" | "mimic" | "mirrormove" | "transform"
+                )
+            }) {
+                Some("external-move-access")
+            } else {
+                None
+            };
+            if let Some(reason) = reason {
+                *excluded.entry(reason.to_owned()).or_default() += 1;
+                continue;
+            }
+            let species = &dex_json["species"][toid(set["species"].as_str().unwrap())];
+            assert!(!species.is_null());
+            let old_dv = iv(set, "atk") / 2;
+            let new_dv = (0..=old_dv)
+                .find(|&a| {
+                    a % 2 == old_dv % 2
+                        && gender(species, a) == gender(species, old_dv)
+                        && shiny(set, a) == shiny(set, old_dv)
+                })
+                .unwrap();
+            if old_dv == new_dv {
+                already_low_dv += 1;
+            }
+            let mut proposed = set.clone();
+            // These catalog records carry complete maps; refuse ambiguous defaults.
+            assert!(set["ivs"].is_object() && set["evs"].is_object());
+            proposed["ivs"]["atk"] = json!(new_dv * 2);
+            proposed["evs"]["atk"] = json!(0);
+            if new_dv == old_dv && set["evs"]["atk"] == 0 {
+                continue;
+            }
+            let mut one_changed = original.clone();
+            one_changed[slot] = proposed.clone();
+            let mut before = battle(&dex, &original, slot);
+            let mut after = battle(&dex, &one_changed, slot);
+            let a = before.poke(before.active_id(0).unwrap());
+            let z = after.poke(after.active_id(0).unwrap());
+            assert_eq!(a.maxhp, z.maxhp);
+            assert_eq!(a.gender, z.gender);
+            assert_eq!(a.stored_stats[1..], z.stored_stats[1..]);
+            assert!(z.stored_stats[0] <= a.stored_stats[0]);
+            let stats_before = a.stored_stats;
+            let stats_after = z.stored_stats;
+            let hp = a.maxhp;
+            let mut damage = Vec::new();
+            for m in &moves {
+                damage.push(json!({"move":m,
+                    "neutralBefore":self_hit(&dex, &mut before, m, 0, 0),
+                    "neutralAfter":self_hit(&dex, &mut after, m, 0, 0),
+                    "swaggerBefore":self_hit(&dex, &mut before, m, 2, 0),
+                    "swaggerAfter":self_hit(&dex, &mut after, m, 2, 0)}));
+                for atk in -6..=6 {
+                    for def in -6..=6 {
+                        let old = self_hit(&dex, &mut before, m, atk, def);
+                        let new = self_hit(&dex, &mut after, m, atk, def);
+                        assert!(
+                            new <= old,
+                            "self-hit increased: {base_id}/{slot}/{m}/{atk}/{def}"
+                        );
+                        comparisons += 1;
+                    }
+                }
+            }
+            rows.push(
+                json!({"baseId":base_id,"slot":slot+1,"species":set["species"],
+                "level":set["level"],"gender":set["gender"],"hp":hp,
+                "attackDvBefore":old_dv,"attackDvAfter":new_dv,
+                "attackEvBefore":set["evs"]["atk"],"attackEvAfter":0,
+                "attackBefore":stats_before[0],"attackAfter":stats_after[0],"damage":damage}),
+            );
+            team["sets"][slot] = proposed;
+            changed = true;
+        }
+        if changed {
+            changed_teams += 1;
+            team["baseId"] = json!(base_id);
+            team["id"] = json!(format!("{base_id}-low-atk"));
+        }
+        // Selection scores were measured on the original sets, never these proposals.
+        if let Some(score) = team.as_object_mut().unwrap().remove("score") {
+            team["baselineScore"] = score;
+        }
+        let check = validate_team(&dex, &ls, &team["sets"].to_string());
+        assert_eq!(check["ok"], true, "candidate {}: {check}", team["id"]);
+    }
+    // Fail if a concurrent session changed our input during the audit.
+    assert_eq!(
+        input,
+        fs::read(&input_path).unwrap(),
+        "source changed during audit"
+    );
+    let candidate = json!({"format":"nc2000-low-attack-candidate-v1", "sourcePool":args[1],
+        "sourcePoolSha256":sha(&input),"measurementStatus":"unmeasured candidate; baselineScore is for original sets",
+        "drawRule":pool["drawRule"],"teams":teams});
+    let report = json!({"format":"nc2000-low-attack-audit-v1","sourcePool":args[1],
+        "sourcePoolSha256":sha(&input),"dexSha256":sha(&dex_bytes),
+        "teams":teams.len(),"changedTeams":changed_teams,"changedSets":rows.len(),
+        "eligibleAlreadyAtMinimumDv":already_low_dv,"excluded":excluded,
+        "checks":{"sourceAndCandidateTeamsValidated":teams.len(),"selfHitComparisons":comparisons,
+            "selfHitIncreases":0,"preserved":"HP, gender, shiny DV predicate, all non-Attack stats, moves, items, levels, draw weights",
+            "scope":"current native engine; each selected move's base type and held item; Attack and Defense stages -6 through +6; no burn, weather or screens"},
+        "limitations":["Struggle damage also decreases: no unconditional dominance or win-rate claim",
+            "Hidden Power and Physical-category moves conservatively excluded, including fixed damage",
+            "Metronome, Mimic, Mirror Move and Transform excluded; Sleep Talk only accesses the unchanged own moves",
+            "Changing gender could affect Attract: gender is preserved",
+            "Built-in validator checks flat learnsets; it does not certify every event or egg combination",
+            "Source catalog, inventory, prior, Nash mixture and compiled preview artifacts remain untouched"],
+        "rows":rows});
+    fs::create_dir_all(output.parent().unwrap()).unwrap();
+    fs::create_dir(&output).unwrap();
+    write(&output, "candidate-pool.json", &candidate);
+    write(&output, "audit.json", &report);
+    println!(
+        "{} teams, {} changed teams, {} changed sets, {} self-hit comparisons; source untouched",
+        teams.len(),
+        changed_teams,
+        rows.len(),
+        comparisons
+    );
+}
diff --git a/data/team-pool-v2/README.md b/data/team-pool-v2/README.md
index b1c0cdf..67641e7 100644
--- a/data/team-pool-v2/README.md
+++ b/data/team-pool-v2/README.md
@@ -25,4 +25,54 @@ clusters) — near copies of one design do not multiply its share. Both Random
 buttons and the ladder's `pool:random` use these weights; the selection's
 pool value `V` was measured under the same rule.
 
-`score` on each entry is the confirmation panel score (fresh seeds, stage C).
+`score` on each entry is the confirmation panel score (fresh seeds, stage C)
+of the original inventory sets, before the optimization below. No new win-rate
+measurement is claimed for the optimized sets.
+
+## Low-Attack optimization
+
+The generator applies `tools/optimize-low-attack.js` to the playable catalog:
+14 parties / 27 sets have Attack EV reduced to 0 and Attack DV minimized while
+preserving HP DV and the shiny DV predicate. Other stats, moves,
+items, levels, team IDs and draw weights are preserved. Sets with a Physical
+move (using this generation's categories), any Hidden Power, Metronome,
+Mimic, Mirror Move or Transform are excluded. Sleep Talk is allowed when the
+set's own moves otherwise qualify. An odd Attack DV preserves maximum HP.
+
+Version 2 allows female preference in these qualifying sets when the frozen
+prior's weighted direct-Attract sources favor it. Attract works only between
+opposite genders: female is immune to a female user, but susceptible to a
+male user. The prior has Ninetales F (team weight 1) and Snorlax M (0.25).
+This favors female on a source-weight proxy; it is not a measured encounter
+rate or win-rate improvement. The catalog and Nash support contain no direct
+Attract, so a catalog-only mirror has no direct Attract advantage either way.
+
+Six formerly male sets now use female DV 1 instead of male DV 3: Venusaur in
+`rental-cban-8`, `sample-10`, `mjj-2014-thdrcomb`; Umbreon in `sample-06`;
+Jolteon in `mjj-2010-garap-a`; Vaporeon in `rental-cban-14`. HP and every
+non-Attack stat stay identical; Attack falls another 2 points. Fixed gender,
+genderless and already-female sets keep their gender. Own Attract users keep
+their gender, and shiny constraints can prevent a female change. The pure
+optimizer preserves gender unless this preference is explicitly enabled.
+
+The original inventory, frozen belief prior, measured Nash mixture and
+selection/reference evidence remain unchanged. Only the catalog applies
+this policy, so rebuilding products reproduces it. The `setOptimization`
+metadata identifies the policy and the historical basis of `score`.
+
+The baseline audit in `findings/low-attack-catalog-v1/audit.json` records all
+27 changes and 18,252 native-engine self-hit comparisons (each move, Attack
+and Defense stages -6 through +6, no burn/weather/screens): no self-hit
+increase and unchanged HP, gender and non-Attack stats in that first pass.
+`findings/attract-gender-v1/mechanics.json` independently verifies the six
+version-2 changes: nine exact gender-only Attract cases, 4,056 additional
+self-hit comparisons, and unchanged HP/non-Attack stats. All 24 optimized
+teams pass the engine validator. Struggle also loses power; this is a
+practical configuration optimization, not a universal dominance claim.
+
+Checks: `node --test tools/optimize-low-attack.test.js`. Reproduce the baseline
+audit using `crates/engine/examples/low_attack_catalog_audit.rs` and an original
+catalog input. Exact-own-set preview caches need regeneration or their
+existing mismatch fallback when these catalog sets are integrated.
+The gender audit is reproducible with `attract_gender_audit` using the
+`d7cb2fc` catalog as the baseline and the current catalog as the new pool.
