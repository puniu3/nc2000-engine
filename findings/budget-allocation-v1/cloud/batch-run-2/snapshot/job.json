{
  "tasks": [
    {
      "id": "command",
      "argv": [
        "python3",
        "command_worker.py"
      ]
    }
  ],
  "concurrency": [
    1
  ],
  "repeats": 1,
  "task_timeout_seconds": 1800,
  "bootstrap": "bootstrap.sh",
  "outputs": "results",
  "binary": "/usr/bin/true",
  "input_sha256": {},
  "resources": {
    "provider": "gcp-batch",
    "instance_type": "e2-standard-16",
    "volume_gib": 30,
    "ttl_seconds": 1800,
    "budget_yen": 200.0,
    "yen_per_usd": 160,
    "output_limit_bytes": 209715200
  }
}
