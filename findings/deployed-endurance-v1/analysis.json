  "interpretation": [
    {
      "status": "observed",
      "claim": "In the 129-turn mirror, the bot spent Soft-Boiled PP at full HP and spent many turns selecting Counter."
    },
    {
      "status": "observed",
      "claim": "At turn 10, side1 chooses Soft-Boiled at81k but Ice Beam at243k and729k. At turn53, side0 still chooses full-HP Soft-Boiled at729k."
    },
    {
      "status": "inference",
      "claim": "Some early-healing choices are sensitive to compute, but increasing compute up to729k does not remove the late full-HP healing pattern. Resource valuation and long-horizon continuation quality are candidates, not isolated causes."
    },
    {
      "status": "observed",
      "claim": "Frozen Blissey remained in, thawed after turn32, and recovered. Keeping a frozen tank in was not automatically a wasted turn."
    },
    {
      "status": "limited_transition_evidence",
      "claim": "At the frozen root, Thunder, Ice Beam and Soft-Boiled had matching next stateView and PRNG for all320 tested foe-action/seed combinations per comparison. Counter priority changed random consumption. This is not a proof over hidden fields or all states."
    },
    {
      "status": "hypothesis",
      "claim": "Deduplicating truly equivalent incapacitated actions may improve budget allocation, but requires a semantic equivalence proof and a strength test before shipping."
    },
    {
      "status": "scope",
      "claim": "Eight purposively selected games and one conditional strategy experiment do not establish catalog-wide frequency, general playing strength, or global optimality."
    }
  ]
